<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.wlife.fac.batch.smp.df.mapper.BFFACDF01MAPPER">

    <!-- 기본 예제 Sample 목록 조회-->
    <select id="selectSample01List" resultType="kr.co.wlife.fac.batch.smp.df.vo.BFFACDF01DTO$selectSample01ListVO">
        SELECT /* BFFACDF01MAPPER.selectSample01List */
               ANCM_NTF_ID
             , TITL
             , CONT
             , IQCNT
             , IPDTM
             , INPP_CD
          FROM BIZ_USER.TBPSB0015
         WHERE ANCM_NTF_ID LIKE #{ancmAtfId}||'%'
    </select>

</mapper>