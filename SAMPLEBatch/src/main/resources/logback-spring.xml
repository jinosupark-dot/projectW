<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ================================================== -->
    <!-- 프로퍼티                                           -->
    <!-- ================================================== -->
    <property name="LOG_DIR" value="./logs"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{jobName}/%X{stepName}] %logger{36} - %msg%n"/>

    <!-- ================================================== -->
    <!-- APPENDER 정의 (logger/root 보다 먼저)               -->
    <!-- ================================================== -->

    <!-- 콘솔 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="kr.co.wlife.common.batch.logging.BatchMetaTableFilter"/>
        <encoder>
            <!-- <pattern>[%d{yyyy-MM-dd HH:mm:ss}] %highlight(%-5level) : %yellow(%logger{36}) : %cyan(%msg)%n</pattern> -->
			<!-- <pattern>[%d{yyyy-MM-dd HH:mm:ss}] %-5level : %logger{36} : %msg%n</pattern> -->
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %highlight(%-5level) : %yellow(%logger{36}) : %cyan(%msg%n)</pattern>
        </encoder>
    </appender>

    <appender name="SQL_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="kr.co.wlife.common.batch.logging.BatchMetaTableFilter"/>
        <encoder>
            <pattern>[%d{yyyy-MM-dd HH:mm:ss}] %red(%-5level) : %red(SQL) : %red(%msg)%n</pattern>
        </encoder>
    </appender>
	

    <!-- [공통로그] Job 실행별 파일 (Job/Step 리스너 로그 전용) -->
    <appender name="JOB_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>logFile</key>
            <defaultValue>batch-common</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${logFile}" class="ch.qos.logback.core.FileAppender">
                <file>${LOG_DIR}/${logFile}.log</file>
                <append>true</append>
                <encoder><pattern>${LOG_PATTERN}</pattern></encoder>
            </appender>
        </sift>
        <timeout>1 minute</timeout>
    </appender>

    <!-- [일반로그] 일자별 파일 -->
    <appender name="BATCH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="kr.co.wlife.common.batch.logging.BatchMetaTableFilter"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/batch.%d{yyyyMMdd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>${LOG_PATTERN}</pattern></encoder>
    </appender>

    <!-- [요약로그] 탭 구분 한 줄 로그 -->
    <appender name="TR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/batch-transaction.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/batch-transaction.%d{yyyyMMdd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <!-- 청크 JSON 로그 -->
    <appender name="CHUNK_JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/chunk-json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/chunk-json.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder><pattern>%msg%n</pattern></encoder>
    </appender>

    <!-- ================================================== -->
    <!-- LOGGER 정의                                        -->
    <!-- ================================================== -->

    <!-- Job/Step 공통 리스너 로그 -> Job별 파일 + 콘솔 (일반 파일에는 안 들어감) -->
    <logger name="kr.co.wlife.common.batch.logging.CommonJobLoggingListener" level="INFO" additivity="false">
        <appender-ref ref="JOB_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="kr.co.wlife.common.batch.logging.CommonStepLoggingListener" level="INFO" additivity="false">
        <appender-ref ref="JOB_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
	
	<!-- FWKBatch 콘솔 TODO 콘솔에 출력안됨 -->
	<!-- <logger name="kr.co.wlife.common.batch.history.mapper" level="DEBUG" additivity="false"> -->
	<logger name="kr.co.wlife.common.batch" level="DEBUG" additivity="false">
		<appender-ref ref="CONSOLE"/>
	</logger>

    <!-- 한 줄 요약 로그: 요약 파일에만 -->
    <logger name="BatchTransactionLog" level="INFO" additivity="false">
        <appender-ref ref="TR_FILE"/>
    </logger>

    <logger name="CHUNK_JSON_FILE_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="CHUNK_JSON_FILE"/>
    </logger>

    <logger name="log4jdbc.log4j2" level="OFF"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.springframework.jdbc.support.JdbcTransactionManager" level="WARN"/>
    <logger name="org.springframework.jdbc" level="WARN"/>

    <logger name="jdbc.sqlonly" level="OFF" additivity="false"/>
    <logger name="jdbc.sqltiming" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_CONSOLE"/>
        <appender-ref ref="BATCH_FILE"/>
    </logger>
    <logger name="jdbc.connection"     level="OFF"/>
    <logger name="jdbc.audit"          level="OFF"/>
    <logger name="jdbc.resultset"      level="OFF"/>
    <logger name="jdbc.resultsettable" level="OFF"/>

    <logger name="kr.co.wlife.jhb.batch.asm.journalrule.mapper" level="INFO"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="kr.co.wlife.jhb" level="DEBUG"/>

    <!-- 일반 로그: 콘솔 + 일자별 파일 -->
    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="BATCH_FILE"/>
    </root>

</configuration>