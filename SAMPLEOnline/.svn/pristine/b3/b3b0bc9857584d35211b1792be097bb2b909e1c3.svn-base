          <tr>
            <td class="tc">3</td>
            <td><a href="#">사업비 기준정보 설정</a></td>
            <td class="tc"><img src="../img/img_status_03.png"></td>
            <td class="tc">Y</td>
            <td class="tc">D-2</td>
            <td class="tc">2020-02-25</td>
            <td class="tc">2020-02-25 15:55:00</td>
            <td class="tc">재무회계부</td>    
          </tr>             
          

        </tbody>
      </table>
    </div>   
    <!-- 리스트//--> 
