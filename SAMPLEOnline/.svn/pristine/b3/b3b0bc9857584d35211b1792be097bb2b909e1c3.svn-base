            <td class="tc"><img src="../img/img_status_01.png"></td>
            <td class="tc">Y</td>
            <td class="tc">D-2</td>
            <td class="tc">2020-02-25</td>
            <td class="tc">2020-02-25 15:55:00</td>
            <td class="tc">재무회계부</td>    
          </tr>
          <tr>
            <td class="tc">2</td>
            <td><a href="#">사업비 기준정보 설정</a></td>
            <td class="tc"><img src="../img/img_status_02.png"></td>
            <td class="tc">Y</td>
            <td class="tc">D-2</td>
            <td class="tc">2020-02-25</td>
            <td class="tc">2020-02-25 15:55:00</td>
            <td class="tc">재무회계부</td>    
