	static Logger logger = LoggerFactory.getLogger(EaiUtil.class);
	
	public static final String EAI_SYSTEM_IFRS17 = "IFB";	//IFRS17 시스템 ID
	public static final String EAI_SYSTEM_SAP = "SAP";	//SAP 시스템 ID
	
	/**
	 * 
	 * @설명: EAI 기본 헤더정보를 생성하여 반환한다.
	 * @최초작성자: 89001203
	 * @최초작성일: 2021. 3. 18.
	 * @최종변경일: 
	 * @매개변수:
	 * @반환값: EaiHeaderBean
	 * @개정이력: 
	 *  89001203 2021. 3. 18. 최초작성
	 */
	public static EaiHeaderBean getRequestHeaderBean() {
		EaiHeaderBean headerBean = null;
		String uuid = UUID.randomUUID().toString();
		
		headerBean = new EaiHeaderBean();
		headerBean.setIfResult(null);
		headerBean.setIfErrCd(null);
		headerBean.setIfErrMsg(null);
		headerBean.setIfTrId(uuid);
		headerBean.setIfSystemCd(EAI_SYSTEM_IFRS17);	//시스템ID
		
		headerBean.setIfHostNm(EAI_SYSTEM_IFRS17);
		//headerBean.setIfPgmId("COMN_PRDCT_");
		//headerBean.setIfReqUId("");
		String requestDateTime = DateUtil.getCurrentDate("yyyyMMddHHmmss");
		headerBean.setIfReqTime(requestDateTime);
		headerBean.setIfBizSvcNm("");
		headerBean.setIfBizMethodNm("");
		headerBean.setIfBizInVONm("");
		headerBean.setIfBizResult(null);
		headerBean.setIfBizErrCd(null);
		headerBean.setIfBizErrMsg(null);
		//=========================================================================================================//
		/*타겟시스템의 로컬PC(개발자)/개발계 로 보낼 경우 ServerInfo.cfg 설정 변경 해야 함 - default:N(개발계) */
		headerBean.setIfFiller(ServerConfig.getInstance().getTransLocalQueue());
		//=========================================================================================================//
		return headerBean;
	}

	/**
	 * 
	 * @설명: EaiMessage를 생성하여 반환한다.
	 * @최초작성자: 89001203
	 * @최초작성일: 2021. 3. 18.
	 * @최종변경일: 
	 * @매개변수: byte [] requestData : 전문 Body byte
	 * @반환값: EaiMessage
	 * @개정이력: 
	 *  89001203 2021. 3. 18. 최초작성
	 */
	public static EaiMessage getRequestMessage(byte [] requestData) {
		EaiMessage reqMessage = null;
		reqMessage = EaiFactory.getInstance().newMessage();
		reqMessage.setData(requestData);
		reqMessage.setTimeoutSec(30);		// 타임아웃 설정
    	//sreqMsg.setTimeToLiveSec(20);	// 요청전문 유지시간 설정 (장애로 인해 수신프로세스가 메시지를 처리하지 못한 경우 메지지 삭제 처리)
		return reqMessage;
	}
	
	/**
	 * 
	 * @설명: EAI Message를 전송한다.
	 * @최초작성자: 89001203
	 * @최초작성일: 2021. 3. 18.
	 * @최종변경일: 
	 * @매개변수: String queueId : EAI queueID
	 * @매개변소: EaiMessage : 전송할 EAI Message 
	 * @반환값: EaiHeaderBean
	 * @개정이력: 
	 *  89001203 2021. 3. 18. 최초작성
	 */
	public static EaiHeaderBean sendData(String queueId, EaiMessage reqEaiMessage) throws Exception {
		EaiMessage resMessage = null;
		EaiProxy proxy= null;
		EaiHeaderBean resBean = null;
		try {
			proxy = EaiFactory.getInstance().newProxy();
			resMessage = proxy.requestReply(queueId, reqEaiMessage);	// queue.cfg의 논리큐명 설정 : [SEND_QUEUE]
			
			EaiHeaderMgr reqMgr = EaiFactory.getInstance().newHeaderMgr();
			String resMessageString = resMessage.getDataString();
			logger.debug("resMessageString:" + resMessageString);
			resBean = reqMgr.getHeaderParse(resMessageString);
    	}catch(EaiException ie){
    		logger.error("code:"+ie.code + ",  message:" + ie.getMessage());			
    		throw ie;
		} catch(Exception e) {
			logger.error("Exception Occurs!", e);
			throw e;
		} finally {
			
		}
		return resBean;
	}
	
	/**
	 * 
	 * @설명: EAI를 이용하여 File을 타 시스템으로 전달한다.(File To File
	 * @최초작성자: 89001203
	 * @최초작성일: 2021. 3. 18.
	 * @최종변경일: 
	 * @매개변수: String userId : 전문 호출자 ID
	 * @매개변수: String sourceSystemCode : 소스 시스템 코드
	 * @매개변수: String sourceSystemPath : 전송할 File경로
	 * @매개변수: String sourceSystemFileName : 전송할 파일명
	 * @매개변수: String transferredFilesCount : 전송대상 파일 갯수 
	 * @매개변수: String actionAfterTransfer : 전송후 파일처리 구분
	 * @매개변수: String sourceSystemFileBackupPath : 전송 후 파일 백업 시 경로
	 * @매개변수: String targetSystemCode : 타겟 시스템 코드
	 * @매개변수: String targetSystemCode : 타겟 시스템 파일경로
	 * @반환값: EaiHeaderBean
	 * @개정이력: 
	 *  89001203 2021. 3. 18. 최초작성
	 */
	public static EaiHeaderBean sendEaiFile(String userId, String sourceSystemCode, String sourceSystemPath, String sourceSystemFileName, String transferredFilesCount, String actionAfterTransfer, String sourceSystemFileBackupPath, String targetSystemCode, String targetSystemPath) {
		
		EaiHeaderBean resBean = null;
		
		try {
			//1. Header부 셋팅
			EaiHeaderBean header = EaiUtil.getRequestHeaderBean();
			header.setIfId("IERFF50100");	//경리중계전표정보(배치) IFRS18 -> SAP	FiltToFile
			header.setIfReqUId(userId);	//호출자
			
			//2. Body부 생성
			StringBuilder body = new StringBuilder();
			
			//순서가 보장되어야 하네
			Map bodyMap = new LinkedHashMap();
			bodyMap.put("sourceSystemCode", sourceSystemCode);
			bodyMap.put("sourceSystemPath", sourceSystemPath);
			bodyMap.put("sourceSystemFileName", sourceSystemFileName);
			bodyMap.put("transferredFilesCount", transferredFilesCount);
			bodyMap.put("actionAfterTransfer", actionAfterTransfer);
			bodyMap.put("targetSystemCode", targetSystemCode);
			bodyMap.put("targetSystemPath", targetSystemPath);
			String bodyXml = XMLUtil.mapToDocumentString(bodyMap, "eaiCommonFileVO");
			System.out.println("bodyXML:[" + bodyXml + "]");
			header.setBody(bodyXml);
			
			//3. Eai RequestMessage 생성
			EaiHeaderMgr reqMgr = EaiFactory.getInstance().newHeaderMgr();
			byte[] requestDataByte = reqMgr.getData(header);
			EaiMessage reqEaiMessage = EaiUtil.getRequestMessage(requestDataByte);
			
			System.out.println("reqEaiMessage:" + reqEaiMessage);
			//4. Eai Send
			resBean = EaiUtil.sendData("I.EAI.ETC.ALL.FTPDaemon", reqEaiMessage);

		} catch(Exception e) {
			e.printStackTrace();
		}
		
		return resBean;
	}
	
