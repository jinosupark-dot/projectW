			Map resBodyMap = XMLUtil.documentStringToMap(resBean.getBody());
			System.out.println("====resBodyMap:" + resBodyMap);
			String eSubrc = (String)resBodyMap.get("eSubrc");
			Map iPSapsSlpSndHedrVOMap = (Map)resBodyMap.get("iPSapsSlpSndHedrVO");
			System.out.println("====iPSapsSlpSndHedrVOMap:" + iPSapsSlpSndHedrVOMap);
			
			
			
		} catch(Exception e) {
			e.printStackTrace();
		}
	}	

