/*******************************************************************
**   시스템명   : (부채결산)IFRS17
**   업무명     : 재보험사별신용등급변동내역
**   설명       : 재보험사별신용등급변동내역 수정입력 화면
**   최조작성자  : 조예리
**   최조작성일  : 2021.03.02
**   최종변경일  : 2021.06.18
**   개정이력    :
**    - 조예리 2021.03.02 신규작성
**    - 조예리 2021.03.18 1차검증
**    - 조예리 2021.04.27 2차표준화 
**    - 조예리 2021.06.18 3차표준화  
*******************************************************************/

//전역변수 선언
var initObject = null;					//수정전 원데이터
let today = new Date();
let year = today.getFullYear();
let month = ((today.getMonth() + 1) < 10) ? "0" + (today.getMonth() + 1) : today.getMonth() + 1;
const toYm = year + "-" + month;
var perBtnId = ["btn_save"];

$(document).ready(function(){

	//권한별 버튼제어
	//button permission
	var arrPerBtn = new Array();
	for(var i=0; i<perBtnId.length; i++){
		var perBtn = new Object();
		perBtn.btnId  = "#" + perBtnId[i];
		perBtn.action = "R";
		arrPerBtn.push(perBtn);
	}
	$.fn.setBtnPermission(arrPerBtn);

	//툴팁 및 메뉴ID
	$("#imgToolTip").attr("title", parent.viewPath);
	$($("h3")[0]).text($.fn.getMenuNm()+" :: ["+$.fn.getMenuId()+"]");
	
	//공통코드 조회
	selectCommonCode();
	
	//event 초기화
	initEvent();
	
	//조회
	initGrid();	
	
	//검색조건 마감년월 포커스 이동
	$("#finYm").focus();
});


/**
 * @설명: 공통코드 조회
 * @최초작성자: 62000290
 * @최초작성일: 2021.04.12
 * @최종변경일: 
 * @개정이력: 
 *  62000290 2021.04.12 최초작성
 */
function selectCommonCode() {
	// 공통코드 조회(재보험회사코드, 재보험회사신용등급코드)
	$.fn.loadCommonCode(["RINS_CO_CD","RBC_CRDT_GRD_CD"]);
	
	// 콤보박스 세팅
	var paramObj = {};
	paramObj.codeArr = ["RINS_CO_CD","RBC_CRDT_GRD_CD"];	
	paramObj.selArr = ["sbx_rinsCoCd","sbx_rbcCrdtGrdCd"];	
	paramObj.displayMode = "value delim label";			
	paramObj.displayDelimiter = ":";
	paramObj.firstOptionText = ["-전체-"];
	
	$.fn.renderCombobox(paramObj);
}

/**
 * @설명: event 초기화
 * @최초작성자: 62000290
 * @최초작성일: 2021.04.12
 * @최종변경일: 
 * @개정이력: 
 *  62000290 2021.04.12 최초작성
 */
function initEvent() {
	//마감년월 입력창 blur
	$('#finYm').on('blur', function(e) {
		//빈값 체크
		if($.fn.isEmpty(this.value)) {
			return;
		}
		
		//날짜형식 체크
		if($.isValidYm(this.value)) {
			$(this).val($.fn.monthFormat(this.value));
		} else {
			$.fn.msgBox('마감년월의 날짜 형식이 맞지 않습니다. 다시 입력해주세요.');
			$(this).focus();
		}
	});
	
	//조회
	initGrid();
	
	//마감년월 달력버튼 click
	$("#btn_finYm").on("click", function(e){
		$("#finYm").datepicker("show");
	});
	
	//조회
	$('#btn_search').on('click', function(e){
		selectRinsCoCrdtGrdFlctList();
	});
	
	//저장
	$('#btn_save').on('click', function(e){
		saveGridDataAll();
	});
	
	//행추가
	$('#btn_addGrid').on('click', function(e){
		addGridData();
	});
	
	//양식다운로드
	$('#btn_exportExcel').on('click', function(e){		
		var gridId = 'gridDiv';
		var fileName = '재보험사별신용등급변동내역_업로드양식.xlsx';

		var paramObj = {};
		paramObj.id = gridId;
		paramObj.fileName = fileName;         // 다운로드할 파일명
		paramObj.applyItemTemplate = false;   // 그리드 컬럼 디스플레이 포멧터 적용 출력 여부(해당엑셀로 Import하기 위해서는 false)
		$.fn.exportGridExcel(paramObj);
	});

	
	//엑셀업로드
	$("#btn_loadExcel").on("click", function(e){
		var paramObj = {};
		
		paramObj.id = "gridDiv";					//그리드 ID
		paramObj.callbackFn = function(data) {		//그리드 바인딩 후 후처리 함수
			if(data.result == "1") {
				$.fn.msgBox("정상적으로 로드하였습니다.");

				//엑셀데이터 형식 맞추기
				loadGridSetting();
			}
		};
		$.fn.loadGridExcel(paramObj);
	});

	//조회조건 엔터키 조회
	$("#finYm").on("keypress", function(e) {
		if(e.keyCode == 13) {
			$("#btn_search").click();
			return false;
		}
	});
}


/**
 * @설명: jsGrid 빈 테이블 생성 
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function initGrid(){
	// jsGrid 빈 테이블 생성
	var gridObject = new ComJsGrid({
		id: 'gridDiv',
		height: 600,
		editing: true,
		sorting: true,
		paging: true,
		selectHiglight:false,
		deleteConfirm: '삭제하시겠습니까?',
		controller : {
			updateItem : function(item) {	//Edit모드에서 적용 아이콘 또는 updateItem API를 이용시 진입
				var status = 'u';	//수정
				if(item.status == 'c' || item.status == 'e') {	//신규, 엑셀로드는  c, e상태 유지 후 데이터 수정
				} else if(item.status == 'dd'){	//삭제신청으로 요청되면 '삭제'로 최정 변경처리
					item.status = 'd';
				} else {
					item.status = status;
				}
				return item;
			},
			deleteItem : function(item) { //grid 삭제 아이콘 클릭 또는 deleteItem API이용시 진입
				//deleteItem에서 dd로 -> updateItem에서 최종 d상태가 됨.
				var status = 'dd';	//삭제 신청
				if(item.status == 'c' || item.status == 'e') {	//신규, 엑셀로드 입력대상건으로 그리드만 삭제처리
					jsGridDeletionFailed = false;
				} else  {	//u,d 는 삭제 상태로 처리 -> updateItem에서 최종  삭제대기가 됨.
					jsGridDeletionFailed = true;
					item.status = status;
					$("#gridDiv").jsGrid("updateItem", item);
					return item;
				}
			}			
		},
		onItemEditing: function(args) {	//Grid Edit모드 진입시 처리
			if(typeof event === "undefined") {
				args.cancel = true;
				return;
			}
			
			//체크박스는 Edit 모드 취소
			var targetElem = event.srcElement;
			if( targetElem.outerHTML.indexOf("check") > 0) {
				args.cancel = true;
			}
			
			//delete 상태 스킵
			if( args.item.status == 'd') {
				args.cancel = true;
			}
			
		},
	   fields: [
		{ name: 'finYm', title:'마감년월', css:'cell', type: 'text', width: 70, align:'center', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				// 신규, 수정인 경우에만 수정가능
				if(item.status != 'c' && item.status != 'e') {
					$result.attr('readonly', 'true');
				}
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				}).on("input keyup", function(e) {
					//숫자입력만 가능
					var val = $(this).val();
					$(this).val(val.replace(/[^\d]/g, "").substr(0,6));
				});
				
				return $result;
			}, 
			validate: [{validator:'pattern', message:'[마감년월] 날짜 형식이 맞지 않습니다.', validator:function(value) {return $.isValidYm(value);}}]
		},
		{ name: 'rinsCoCd', title:'재보험회사코드', css:'cell', type: 'select', width: 100, align:'left', editTemplate:function(value, item) {
			var $result = jsGrid.fields.select.prototype.editTemplate.call(this, value, item);
				// 신규 외엔 수정 불가
				if(item.status != 'c' && item.status != 'e') {
					$result.attr("disabled","true");
				}
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				});
				
				return $result;
			}, 
			items:  $.fn.getGridCodeItem("RINS_CO_CD", true, "value delim label"),
			textField: "codeNm",
			valueField: "code"
		},
		{ name: 'rinsCoCrdtGrdCd', title:'재보험회사신용등급코드', css:'cell', type: 'select', width: 120, align:'left', editTemplate:function(value, item) {
			var $result = jsGrid.fields.select.prototype.editTemplate.call(this, value, item);
			
			$result.on("keydown", function(e){
				if(e.which === 13){
					$("#gridDiv").jsGrid("updateItem");
					return false;
				}
			});
			
			return $result;
			},
			items:  $.getCodeItem("RBC_CRDT_GRD_CD"),
			textField: "codeNm",
			valueField: "code"
		},
		{ name: 'dshnPbb', title:'부도확률', css:'cell', type: 'text', width: 100, align:'right', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				});

				$result.inputFilter(function(value) {					
					if($.isNumberFormat(value)) {
						return true;
					} else {
						return false;
					}
				})
				
				return $result;
			},
			validate: [{validator:'pattern', message:'[부도확률] 소수점 형식이 맞지 않습니다.', validator:function(value) {return $.isNumberFormat(value);}}]
		},
		{ name: 'dshnLosRat', title:'부도손실율', css:'cell', type: 'text', width: 100, align:'right', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				});

				$result.inputFilter(function(value) {					
					if($.isNumberFormat(value)) {
						return true;
					} else {
						return false;
					}
				})
				
				return $result;
			},
			validate: [{validator:'pattern', message:'[부도손실율] 소수점 형식이 맞지 않습니다.', validator:function(value) {return $.isNumberFormat(value);}}]
		},
		{ name: 'regntEno', title:'등록자사번', css:'cell', type: 'text',  width: 100, align:'center', editing: false},
		{ name: 'regDtm', title:'등록일', css:'cell', type: 'text',  width: 100, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.dateFormat(value, "-");			
		}},
		{ name: 'trtrEno', title:'처리자사번', css:'cell', type: 'text',  width: 100, align:'center', editing: false},
		{ name: 'trtDtm', title:'처리일', css:'cell', type: 'text',  width: 100, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.dateFormat(value, "-");			
		}},
		{ name: 'status', title:'상태', css:'cell', type: 'text', width: 30, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.getGridRowStatusName(value);			
		}},
		{ name: 'gridManupulate', title:'그리드조작', css:'cell', type: 'control', width: 50, align:'left',editing: true}] 
		
	});	

	//그리드 생성
	gridObject.gridCreate();
}


/**
 * @설명: 조회
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function selectRinsCoCrdtGrdFlctList() {
	var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
	
	var reqParam = {};
	reqParam.finYm = finYm;

	$.callAjax(reqParam, '/ca/pr/capr812m/selectRinsCoCrdtGrdFlctList.do')
	.done(function(data) {	
		var listData = data.list;  	  	    //서버로 받아온 데이터 리스트
		//그리드 바인딩		
		$('#gridDiv').jsGrid('reset');
		$('#gridDiv').jsGrid('loadData', listData).done(function(){
		});
		
		//0건 그리드 메시지 처리
		if(listData.length == 0){
			$.fn.getReturnValue("gridDiv");
			
		}
			
	}).fail(function(data){
		$.fn.msgBox('목록 조회가 실패했습니다.');
	});		
}


/**
 * @설명: 저장버튼 클릭시 저장
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function saveGridDataAll() {
		
	//그리드 edit모드가 있을 경우, 수정사항 반영
	var editRowClass = $("#gridDiv").jsGrid("option", "editRowClass");
	if($("." + editRowClass).length > 0) {
		$("#gridDiv").jsGrid("updateItem");
	}
	
	var saveList= new Array();	//저장대상 배열 선언
	var gridData = $("#gridDiv").jsGrid("option", "data");	//전체 데이터
	var excelYn = false;		//엑셀업로드여부 확인
	
	//마감년월 셋팅
	var today = new Date();
	var year = today.getFullYear();
	var month = today.getMonth();
	
	var calcDate = new Date(year, month, "1");
	year = calcDate.getFullYear();
	month = '' + (calcDate.getMonth()+1);
	
	if (month.length < 2) month = '0' + month;
	
	var sFinYm = year+month;
	var inputFinYm;
	
	//c,u,d,e 건만 추출
	for(var i = 0; i < gridData.length; i++) {
		var item = gridData[i];
		if(item.status == "c" || item.status == "u" || item.status == "d" || item.status == "e") {
			
			//삭제를 제외한 경우에만 유효값 체크
			if(item.status != "d") {
				//유효값체크
				if(!isValid(i, item)) { return; }
			}
						
			for(var key in item) {
				//입력한 마감년월이 현재시점보다 미래인경우 확인
				if(key == 'finYm'){
					console.log("sFinYm : "+sFinYm+", item[key] : "+item[key]);
					if(sFinYm < item[key]){
						inputFinYm = item[key];
					}
				}else if(key == 'rinsCoCd' || key == 'rinsCoCrdtGrdCd'){
					if(item[key].length == 1){ //자릿수가 한자리인 경우 두자리로 세팅
						item[key] = "0"+item[key];
					}
				}
			}
			
			saveList.push(item);
		}

		//엑셀업로드여부 확인
		if(item.status == "e"){
			excelYn = true;
		}
	}
	
	if(saveList.length == 0) {
		$.fn.msgBox("저장할 대상이 없습니다.");
		return;
	}
	

	var dataYn = false;
	//엑셀업로드여부 확인
	if(excelYn){
		console.log("inputFinYm : "+inputFinYm);

		if (!$.fn.isEmpty(inputFinYm)) {
			confirmMsg = '현재시점('+sFinYm.substr(0,4) + '년 ' + sFinYm.substr(4,2) + '월) 기준으로 \n입력한 [마감년월]은 미래시점의 신용등급 데이터입니다.\n저장하시겠습니까?';	//저장시 확인메시지		
		}else{
			confirmMsg = "업로드한 재보험사별신용등급변동내역 데이터를 저장하시겠습니까?";
		}
				
		//데이터저장
		saveGridData(confirmMsg, saveList);
	}else{		
		if (!$.fn.isEmpty(inputFinYm)) {
			confirmMsg = '현재시점('+sFinYm.substr(0,4) + '년 ' + sFinYm.substr(4,2) + '월) 기준으로 \n입력한 [마감년월]은 미래시점의 신용등급 데이터입니다.\n저장하시겠습니까?';	//저장시 확인메시지			
		}else{
			confirmMsg = "데이터를 저장하시겠습니까?";	//저장시 확인메시지
		}
		
		//데이터 저장
		saveGridData(confirmMsg, saveList);
	}
}


/**
 * @설명: 데이터 저장
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function saveGridData(confirmMsg, saveList) {
	//저장
	$.fn.msgBox(confirmMsg, function (obj) {
		if (obj.btn_ok) {
			$.callAjax({'list':JSON.stringify(saveList)}, '/ca/pr/capr812m/saveRinsCoCrdtGrdFlctList.do')
			.done(function(data) {
				if(data.result == '1') {
					$.fn.msgBox('정상적으로 처리되었습니다.');
					selectRinsCoCrdtGrdFlctList();
				}
			}).fail(function(data){
				$.fn.msgBox('데이터 저장이 실패했습니다.');
			});
		}
	}, 2);		
}


/**
 * @설명: 행추가
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function addGridData() {

	//status컬럼은 그리드 상태 핸들링 하기 위함.(c:신규, u:수정, d:삭제, e:엑셀로드)
	$('#gridDiv').jsGrid('insertItem', 
		{ 
		  'finYm': $.replaceAll($('#finYm').val().trim(),'-',''),
		  'status': 'c',		  
		  'rinsCoCd': '',
		  'rinsCoCrdtGrdCd': '',
		  'dshnPbb': '',
		  'dshnLosRat': '',
		  'regntEno':'',
		  'regDtm': '',
		  'trtrEno':'',
		  'trtDtm': ''
		}
	);
	
	//마지막 페이지 이동
	var pageLastText = $("#gridDiv").jsGrid("option", "pageLastText");
	$(".jsgrid-pager-nav-button a:contains('" + pageLastText + "')").click();
}

/**
 * @설명: 데이터 저장전 validation 체크
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function isValid(rowIndex, item) {
	var rowIdx = rowIndex+1;
	
	if ($.fn.isEmpty(item.finYm)) {
		$.fn.msgBox(rowIdx + '행의 마감년월을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.finYm.trim().length != 6) {
		$.fn.msgBox(rowIdx + '행의 마감년월 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}
	
	if ($.fn.isEmpty(item.rinsCoCd)) {
		$.fn.msgBox(rowIdx + '행의 재보험회사코드를 입력하시기 바랍니다.');
		return false;
	}

	if (item.rinsCoCd.trim().length != 2) {
		$.fn.msgBox(rowIdx + '행의 재보험회사코드 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}
	
	if ($.fn.isEmpty(item.rinsCoCrdtGrdCd)) {
		$.fn.msgBox(rowIdx + '행의 재보험회사신용등급코드를 입력하시기 바랍니다.');
		return false;
	}

	if (item.rinsCoCrdtGrdCd.trim().length != 2) {
		$.fn.msgBox(rowIdx + '행의 재보험회사신용등급코드 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}
	
	if ($.fn.isEmpty(item.dshnPbb)) {
		$.fn.msgBox(rowIdx + '행의 부도확률을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.dshnPbb > 1) {
		$.fn.msgBox(rowIdx + '행의 값 오류(확률은 0부터 1 사이의 값입니다.)');
		return false;
	}
	
	if ($.fn.isEmpty(item.dshnLosRat)) {
		$.fn.msgBox(rowIdx + '행의 부도손실율을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.dshnLosRat > 1) {
		$.fn.msgBox(rowIdx + '행의 값 오류(확률은 0부터 1 사이의 값입니다.)');
		return false;
	}
	
	return true;
}


/**
 * @설명: 업로드 데이터 그리드 세팅
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function loadGridSetting() {

	console.log("loadGridSetting");
	var saveList= new Array();	//저장대상 배열 선언
	var gridData = $("#gridDiv").jsGrid("option", "data");	//전체 데이터
	
	//c,u,d,e 건만 추출
	for(var i = 0; i < gridData.length; i++) {
		var item = gridData[i];
		console.log("item",item);
		if(item.status == "c" || item.status == "u" || item.status == "d" || item.status == "e") {
						
			for(var key in item) {
				//재보험회사코드
				if(key == 'rinsCoCd' || key == 'rinsCoCrdtGrdCd'){

					console.log("key",key);
					console.log("item[key]",item[key]);
					if(item[key].length == 1){ //자릿수가 한자리인 경우 두자리로 세팅
						item[key] = "0"+item[key];
					}
				}
			}
			
			saveList.push(item);
		}
	}
	
	//그리드 바인딩		
	$('#gridDiv').jsGrid('reset');
	$('#gridDiv').jsGrid('loadData', saveList).done(function(){
	});
}

//숫자형 (소수점 8자리) 가능
$.isNumberFormat = function(value){return /^\d{0,2}\.?\d{0,8}$/.test(value);};


/**
 * 
 * @설명: 그리드에 사용할 코드리스트를 반환한다.
 *       본함수를 사용하기전 $.fn.loadCommonCode로 코드정보들을 조회하여야 한다.
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 23.
 * @최종변경일: 2021. 04. 23.
 * @매개변수: codeId : 코드 ID
 * @반환값: void
 * @개정이력: 
 *  62000290 2021. 04. 23. 최초작성
 */
$.getCodeItem = function(codeId) {
	var codeItemList = [];
	var codeDataList = [];
	var displayDelimiter = " : ";
	var firstOptionText = "-선택-";
	var firstOptionValue = "";

	var tmpCodeDataList = $._commonObj["code"][codeId];
	for(var i=0; i<tmpCodeDataList.length; i++) {
		var tmpCode = tmpCodeDataList[i];
		//console.log("tmpCode.code : "+tmpCode.code);
		if(tmpCode.code != '00' && tmpCode.code != '91' && tmpCode.code != '98' 
			 && tmpCode.code != 'S1' && tmpCode.code != 'S2'){ //재보험회사신용등급코드에서 일부코드 제외(00:무위험, 91:AAA기타, 98:기타, S1:주식8%, S2:주식12%)
			var newCode = {
					"code": tmpCode.code,
					"codeNm":tmpCode.code + displayDelimiter + tmpCode.codeNm
			}
			codeDataList.push(newCode);
		}
	}
	
	codeItemList.push({code:firstOptionValue, codeNm:firstOptionText});
	
	return codeItemList.concat(codeDataList);
};
