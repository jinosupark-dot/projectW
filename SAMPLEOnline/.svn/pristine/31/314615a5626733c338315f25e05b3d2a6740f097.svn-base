<!DOCTYPE html>
<html>
<head>
<title>ABL</title>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!--meta name="viewport" content="width=device-width, initial-scale=1"-->
<link rel="stylesheet" type="text/css" media="all" href="../css/basic.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/style.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/gnb.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/xeicon.min.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/jquery.mCustomScrollbar.css" >
<script type="text/javascript" src="../js/common/common.js"></script>
<script type="text/javascript" src="../js/common/html5.js"></script>
<script src="../js/jquery/jquery-1.12.4.js"></script>
<script src="../js/jquery/jquery-ui.js"></script>
<script type="text/javascript" src="../js/gnb/gnb.js"></script>
</head>

<body>


  <!-- content01-->
  <div id="contentWrap" class="clearfix">
    <div class="content_header">
        <div class="main_title clearfix">
            <h3 class="title">search+table</h3>
        </div>
         <!-- //searchform-->      
        <div class="search-form-wrap-d">
            <div class="search-item">
            <!-- 1row -->
            <div class="search-item-inner">
                <div class="item wi265px">
                <p class="title">회계코드</p>
                <div>
                    <input type="text" value="1:GM" class="wi120px">
                </div>
                </div>
                <div class="item wi265px">
                <p class="title">업무분류</p>
                <div>
                    <input type="text" value="30:I17원수" class="wi120px">
                </div>
                </div>
                <div class="item wi360px">
                <p class="title">거래유형</p>
                <div>
                    <input type="text" value="3010:잔여보장BEL">
                </div>
                </div>  
                <div class="item wi360px">
                <p class="title">금액구분</p>
                <div>
                    <input type="text" value="3010100:기시시가 BEL금액">
                </div>
                </div> 
                <!-- //1row -->               
            </div>  
            </div>
            <div class="search-item-btn"> 
                <a href="javascript:void(0);" class=""><i class="xi-search xi-x"></i> 조회</a> 
            </div>
         </div>        
        <!-- //searchform-->
      </div>
        <!--집계마스터/수정/삭제-->
      <div class="sub_title clearfix">
            <h4 class="title">집계마스터 수정/삭제</h4>
        </div>
        <div class="tableWrap">
          <table class="table-detail">        
            <tbody>
              <tr>
                <th>회계코드</th>
                <td>
                  <div>
                    <select>
                      <option>1.GM</option>
                    </select>
                  </div>
                </td>
                <th>업무분류</th>
                <td>
                  <div>
                    <select>
                      <option>30:I원수</option>
                    </select>
                  </div>
                </td>
                <th>거래유형</th>
                <td>
                  <div>
                    <select>
                      <option>3010:잔여보장BEL</option>
                    </select>
                  </div>
                </td>
                <th>금액구분</th>
                <td>
                  <div>
                    <select>
                      <option>3010100:기시시가BEL 금액</option>
                    </select>
                  </div>
                </td>
              </tr>
              <tr>
                <th>금액유형구분</th>
                <td>
                  <div>
                    <select>
                      <option>30:N/A</option>
                    </select>
                  </div>
                </td>
                <th>금액유형상세구분</th>
                <td>
                  <div>
                    <select>
                      <option>99:N/A</option>
                    </select>
                  </div>
                </td>
                <th>원천테이블</th>
                <td>
                  <div>
                    <select>
                      <option>TB_ICASMF11:집합별BEL 변동분석내역</option>
                    </select>
                  </div>
                </td>
                <th>칼럼</th>
                <td>
                  <div>
                    <select>
                      <option>STP_MPRC_BEL_AMT:기시시가BEL금액</option>
                    </select>
                  </div>
                </td>
              </tr>
              <tr>
                <th>발생사고부채</th>
                <td>
                  <div>
                    <select>
                      <option>Y</option>
                    </select>
                  </div>
                </td>
                <th>적용시작년월</th>            
                <td>
                  <div class="cal-group">
                    <input id="inp_closeYm" type="text" class="cal-input form-control datepicker month" onblur="this.value = $.fn.monthFormat(this.value);">
                    <button class="cal" onclick="$('#inp_closeYm').datepicker('show');" ><img src="../img/icon_cal.png"></button>
                  </div>        
                </td>
                <th>적용종료년월 </th>
                <td colspan="3">
                  <div class="cal-group">
                    <input id="inp_closeYm" type="text" class="cal-input form-control datepicker month" onblur="this.value = $.fn.monthFormat(this.value);">
                    <button class="cal" onclick="$('#inp_closeYm').datepicker('show');" ><img src="../img/icon_cal.png"></button>
                  </div>            
                </td>
              </tr>
              <tr>
                <th>비고</th>
                <td colspan="7">
                  <textarea rows="5"></textarea>
                </td>
              </tr>
            <tbody>
          </table>
        </div>
      </div>
        <!--집계마스터/수정/삭제-->
   
  </div>
  <!-- content01//--> 


</body>
</html>
