<!DOCTYPE html>
<html>
<head>
<title>ABL</title>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!--meta name="viewport" content="width=device-width, initial-scale=1"-->
<link rel="stylesheet" type="text/css" media="all" href="../css/basic.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/style.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/gnb.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/xeicon.min.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/jquery.mCustomScrollbar.css" >
<script type="text/javascript" src="../js/common/common.js"></script>
<script type="text/javascript" src="../js/common/html5.js"></script>
<script src="../js/jquery/jquery-1.12.4.js"></script>
<script src="../js/jquery/jquery-ui.js"></script>
<script type="text/javascript" src="../js/gnb/gnb.js"></script>
</head>

<body>


  <!-- content01-->
  <div id="contentWrap" class="clearfix">
    <div class="content_header">
        <div class="main_title clearfix">
            <h3 class="title">search + grid</h3>
        </div>
         <!-- //searchform-->      
        <div class="search-form-wrap-d">
            <div class="search-item">
            <!-- 1row -->
            <div class="search-item-inner">
                <div class="item wi265px">
                <p class="title">회계코드</p>
                <div>
                    <input type="text" value="1:GM" class="wi120px">
                </div>
                </div>
                <div class="item wi265px">
                <p class="title">업무분류</p>
                <div>
                    <input type="text" value="30:I17원수" class="wi120px">
                </div>
                </div>
                <div class="item wi360px">
                <p class="title">거래유형</p>
                <div>
                    <input type="text" value="3010:잔여보장BEL">
                </div>
                </div>  
                <div class="item wi360px">
                <p class="title">금액구분</p>
                <div>
                    <input type="text" value="3010100:기시시가 BEL금액">
                </div>
                </div> 
                <!-- //1row -->               
            </div>  
            </div>
            <div class="search-item-btn"> 
                <a href="javascript:void(0);" class=""><i class="xi-search xi-x"></i> 조회</a> 
            </div>
         </div>        
        <!-- //searchform--> 

    </div>
    <!-- btn -->
    <div class="btnWrap txtar"> 
      <button type="button" class="btn-xlsdown"><span>엑셀다운로드</span></button>
      <button type="button" class="btn-upload"><span>엑셀업로드</span></button>
      <button type="button" class="blue_btn"><span>집계마스터 초기화</span></button>
    </div>
    <!-- btn//--> 
    <!-- table -->
    <div class="tableWrap">
      <table class="tableA">
        <thead>
          <tr>
            <th>회계코드</th>
            <th>회계코드명</th>
            <th>경리업무분류코드</th>
            <th>경리업무분류코드명</th>
            <th>경리거래유형코드</th>
            <th>경리거래유형코드명</th>
            <th>경리금액구분코드</th>
            <th>경리금액구분코드명</th>
            <th>금액구분코드명</th>
            <th>금액유형구분코드명</th>
            <th>금액유형상세구분코드</th>
            <th>금액유형상세구분코드명</th>
            <th>원천테이블ID</th>
            <th>원천테이블명</th>
            <th>컬럼명</th>
            <th>컬럼한글명</th>
            <th>발생사고부채구분코드</th>
            <th>발생사고부채구분코드명</th>
            <th>유효개시일자</th>
            <th>유효종료일자</th>
            <th>비고</th>

          </tr>         
        </thead>
        <tbody>
          <tr>
            <td class="tr">1</td>
            <td>GM</td>
            <td class="tr">30</td>
            <td>I17 원수</td>
            <td class="tr">3010</td>
            <td>잔여보장BEL</td>
            <td class="tr">3010100</td>
            <td>기시시가BEL 금액</td>
            <td class="tr">30</td>
            <td>N/A</td>
            <td class="tr">99</td>
            <td>N/A</td>
            <td>TB_ICASMF11</td>
            <td>집합별 BEL 변동분석내역</td>
            <td>STP_MPRC_BEL_AMT</td>
            <td>가시시가BEL금액</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          </tr>          
        </tbody>
      </table>
    </div>
    <!-- table // --> 
  </div>
  <!-- content01//--> 


</body>
</html>
