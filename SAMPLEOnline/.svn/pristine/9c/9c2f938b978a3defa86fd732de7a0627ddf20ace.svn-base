        <button type="button" class="btn-xlsdown"><span>엑셀다운로드</span></button>
        <button type="button" class="btn-upload"><span>엑셀업로드</span></button>
      </div>
      <!-- table -->      
      <div class="tableWrap ">
        <table class="tableA">
          <thead>            
            <tr>
              <th>재무제표항목/계정과목코드</th>
              <th>Level1</th>
              <th>Level2</th>
              <th>Level3</th>
              <th>Level4</th>
              <th>CoA</th>
              <th>계산식</th>
              <th>상위항목</th>
            </tr>
          </thead>
          <tbody>            
            <tr>
              <td>
                <div class="clearfix">
                  <span class="fl">f17A201000000</span>
                  <span class="fr"></span>
                </div>
              </td>
              <td class="tr" colspan="5" rowspan="3"></td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>            
            </tr>  
            <tr>
              <td>
                <div class="clearfix">
                  <span class="fl">f17A201000000</span>
                  <span class="fr"></span>
                </div>
              </td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>            
            </tr>  
            <tr>
              <td>
                <div class="clearfix">
                  <span class="fl">f17A201000000</span>
                  <span class="fr"></span>
                </div>
              </td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>            
            </tr>                     
          </tbody>
        </table>
      </div>
    <!-- table // --> 
   
    
  </div>
