#gnb {
/* 	position:fixed; 
	display:inline-block;*/
	width: 168px;
	margin: 0px;
	box-sizing: border-box;
	border-left: 1px solid #7b1d18;
	/*border-right: 1px solid #7b1d18;*/
	border-top: 1px solid #b3251c;
	height: 100%;
	z-index: 9;
	background: url(../img/common/lnb_bg.png);
	float:left;
	position: relative;
}
#gnb:after {display:block;content:"";background:#7b1d18;height:100%;position: absolute;width:1px;right:0;top:0;z-index:1;}
#gnb h1 {
	padding: 10px 0;
	margin: 0;
	font-size: 0;
	line-height: 0;
}
#gnb .group_gnb {
 	height: calc(100% - 51px); 
/* 	position: absolute; */
	width: 100%;
	position: relative;
}
#lnb_wrap {
	width: 100%;
	height: 100%;
	position: relative;
}
#cssmenu, #cssmenu ul, #cssmenu ul li a {
	margin: 0;
	padding: 0;
	border: 0;
	list-style: none;
	line-height: 1;
	display: block;
	position: relative;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
#cssmenu ul li {
	margin: 0;
	padding: 0;
	display: block;
	position: relative;
	background: #b9261c;
}
#cssmenu ul li a:hover, #cssmenu ul li a.active {
	color: #fffbb8;
}
#cssmenu ul ul {
	display: none;
}
#cssmenu > ul > li.active > ul {
	display: block;
}
.align-right {
	float: right;
}
#cssmenu > ul > li.open > a {
	color: #fffbb8;
}
#cssmenu > ul > li > a {
	border-bottom: 1px solid #7b1d18;
	padding: 11px 10px 10px 10px;
	cursor: pointer;
	z-index: 2;
	font-size: 15px;
	font-weight: 600;
	text-decoration: none;
	-webkit-transition: color .2s ease;
	-o-transition: color .2s ease;
	transition: color .2s ease;
	color: #fff;
	letter-spacing: -0.5px;
}
#cssmenu > ul > li > a:hover {
	color: #fffbb8;
}
#cssmenu ul > li.has-sub > a:after {
	position: absolute;
	right: 12px;
	top: 14px;
	z-index: 5;
	display: block;
	height: 7px;
	width: 10px;
	background: url(../img/gnb_open.png);
	content: "";
}
#cssmenu ul > li.has-sub.open > a:after {
/* 	position: absolute; */
	right: 12px;
	top: 14px;
	display: block;
	height: 7px;
	width: 10px;
	background: url(../img/gnb_close.png);
	content: "";
}
#cssmenu ul ul {
	
 	width:100%; 
	z-index:99;
	padding: 0;
	position: relative;
}
#cssmenu ul ul li {
	background: #f3eae3 url(../img/common/lnb_line.png) repeat-y right top;
	position: relative;
	
}
#cssmenu ul ul li a {
	
	padding: 9px 10px 10px 27px;
	cursor: pointer;
	border-bottom: 1px solid #c5c5c5;
	z-index: 2;
	text-decoration: none;
	color: #444444;
	font-size: 12px;
	font-weight: 600;
	-webkit-transition: color .2s ease;
	-o-transition: color .2s ease;
	transition: color .2s ease;
	letter-spacing: -0.5px;
}
#cssmenu ul ul li a:hover {
	color: #232323;
}
#cssmenu ul ul ul li {
/* 	width:calc(100% - 1px); */
	background: #fff url(../img/common/lnb_line2.png) repeat-y right top;
}
#cssmenu ul ul ul li a {
	padding: 9px 10px 9px 27px;
	cursor: pointer;
	z-index: 2;
	text-decoration: none;
	color: #777777;
	font-size: 12px;
	font-weight: 600;
	-webkit-transition: color .2s ease;
	-o-transition: color .2s ease;
	transition: color .2s ease;
	letter-spacing: -0.5px;
}
#cssmenu ul ul ul li a:hover {
	color: #ee3124;
}
#cssmenu ul ul li.has-sub1 > a:after {
	position: absolute;
	left: 12px;
	top: 10px;
	z-index: 5;
	display: block;
	height: 11px;
	width: 11px;
	background: url(../img/gnb_open_d2.png);
	content: "";
}
#cssmenu ul ul li.has-sub1.open > a:after {
/* 	position: absolute; */
	left: 12px;
	top: 10px;
	z-index: 5;
	display: block;
	height: 11px;
	width: 11px;
	background: url(../img/gnb_close_d2.png);
	content: "";
}
#cssmenu ul ul ul li.has-sub1 {
	border-bottom: 1px solid #bdbdbd;
}
#cssmenu ul ul ul li.has-sub1:last-child {
	border-bottom: none;
}
#cssmenu ul ul ul li.has-sub1 > a {
	background: none;
	border-bottom: 1px solid #e2ccbd;
	margin-top: -1px;
	padding: 10px 10px 10px 27px;
}
#cssmenu ul ul ul li.has-sub2:last-child {
	border-bottom: none;
}
#cssmenu .left_active {
	color: #ee3124;
}

