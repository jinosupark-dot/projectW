<!DOCTYPE html>
<html>
<head>
<title>ABL</title>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<!--meta name="viewport" content="width=device-width, initial-scale=1"-->
<link rel="stylesheet" type="text/css" media="all" href="../css/basic.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/style.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/gnb.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/xeicon.min.css">
<link rel="stylesheet" type="text/css" media="all" href="../css/jquery.mCustomScrollbar.css" >
<script type="text/javascript" src="../js/common/common.js"></script>
<script type="text/javascript" src="../js/common/html5.js"></script>
<script src="../js/jquery/jquery-1.12.4.js"></script>
<script src="../js/jquery/jquery-ui.js"></script>
<script type="text/javascript" src="../js/gnb/gnb.js"></script>
</head>

<body>

<!--- Section -->
<section> 
  
  <!-- content01-->
  <div id="contentWrap" class="clearfix">
    <div class="content_header">
      <div class="main_title clearfix">
        <h3 class="title">계정그룹 생성</h3>
      </div>
      
      <!-- searchform -->
      <div class="search-form-wrap">
        <div class="search-item">
          <div class="search-item-inner fixed">
            <div class="item">
              <p class="title">계정그룹ID</p>
              <div>
                <input type="text" class="wi120px">
              </div>
            </div>
            <div class="item">
              <p class="title">계정그룹명</p>
              <div>
                <input type="text" class="wi180px">
              </div>
            </div>
          </div>
        </div>
        <div class="search-item-btn"> <a href="javascript:void(0);"><i class="xi-search xi-x"></i> 조회</a> </div>
      </div>
      <!-- searchform // --> 
    </div>
    <!-- btn -->
    <div class="btnWrap txtar"> <a href="javascript:void(0);" class="blue_btn"><img src="/img/btn_excel.png" > 엑셀다운로드</a> <a href="javascript:void(0);" class="blue_btn"><img src="/img/btn_excel_upload.png" > 엑셀업로드</a> <a href="javascript:void(0);" class="blue_btn"><img src="/img/btn_save.png" > 저장</a> </div>
    <!-- btn//--> 
    <!-- table -->
    <div class="tableWrap">
      <table class="tableA">
        <thead>
          <tr>
            <th><input type="checkbox" /></th>
            <th>번호</th>
            <th>계정그룹ID </th>
            <th>계정그룹명 </th>
            <th>등록일시 </th>
            <th>변경일시 </th>
          </tr>
        </thead>
        <tbody>
          <tr>
          	<td><input type="checkbox" /></td>
            <td>1</td>
            <td><input type="text" class="wi100" readonly value="SECG0001"></td>
            <td><input type="text" class="wi100"></td>
            <td>2020-02-03</td>
            <td>2020-02-03 </td>
          </tr>
          <tr>
          	<td><input type="checkbox" /></td>
            <td>1</td>
            <td><input type="text" class="wi100" readonly value="SECG0002"></td>
            <td><input type="text" class="wi100"></td>
            <td>2020-02-03</td>
            <td>2020-02-03 </td>
          </tr>
          <tr>
          	<td><input type="checkbox" /></td>
            <td>1</td>
            <td><input type="text" class="wi100" readonly value="SECG0003"></td>
            <td><input type="text" class="wi100"></td>
            <td>2020-02-03</td>
            <td>2020-02-03 </td>
          </tr>
          <tr>
          	<td><input type="checkbox" /></td>
            <td>1</td>
            <td><input type="text" class="wi100" readonly value="SECG0004"></td>
            <td><input type="text" class="wi100"></td>
            <td>2020-02-03</td>
            <td>2020-02-03 </td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- table // --> 
    <p class="grid_control_btn txtar">
    	<a href="javascript:void(0);" class="brown_btn"><img src="/img/btn_icon_plus.png" alt="행추가" /> 행추가</a> <a href="javascript:void(0);" class="brown_btn"><img src="/img/btn_icon_minus.png" alt="행삭제" /> 행삭제</a>
    </p>
  </div>
  <!-- content01//--> 
  <!-- Content //--> 
</section>
<!--- Section -->

</body>
</html>
