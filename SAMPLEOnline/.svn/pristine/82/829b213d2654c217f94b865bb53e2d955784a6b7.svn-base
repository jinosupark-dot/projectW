#EAI_ST_MACHINE
#url1=tcp://10.10.20.26:8222,tcp://10.10.20.26:8224

#OP
#EAI_OP_MACHINE
url1=tcp://21.111.171.153:8222,tcp://21.111.171.152:8224

#queue.cfg를 다시 읽는 주기(초단위), 단 '0'이면 다시 읽지 않음.
#60초(1분) 미만이면 무조건 60초로 처리함.
checktime=0

#[EMS Server 접속 계정]
userid=azlkngs
password=tibazlkngs

#[기본 응답 timeout시간, 초단위]
timeout.sec=34

#[EAI 서버와의 시간차이, 초단위]
time.gap.sec=0

#[EAI의 메시지 expire 기능을 사용할지 여부 , [ON|OFF], default=ON ]
#파일 송수신은 무조건 OFF 임.
use.expire=ON

#[expire된 메시지 이력을 남길지 여부 , [ON|OFF], default=OFF ]
use.expire.msg.logging=OFF

#[EAI서버와의 연결이 끊겼을때 재연결시도할 횟수, default 3 (Interval 2 sec)]
reconnect.count=3

#[Message Encoding, default UTF-8]
message.enc=UTF-8

#[Callback Class Thread(Session) Count, default 10]
max.session.count=10

#[개발계|로컬PC] 전송 여부, default N]-사용여부에 따라 기준정보의 사용큐명이 달라짐
trans.local.queue=N
