	width:360px !important
}
/*line-height*/
.line-height20 {line-height:20px;}

/*color*/
.point{color:#ee2d23}
/*display:none*/
.dpn{display: none;}
.dpb{display: block;}

/*font-weight*/
.fwb{font-weight: bold;}
.fwn{font-weight: normal;}