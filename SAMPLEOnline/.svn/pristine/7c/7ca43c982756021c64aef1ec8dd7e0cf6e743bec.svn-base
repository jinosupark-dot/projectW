<body>

  <!-- content01-->
  <div id="contentWrap" class="clearfix">
    <div class="content_header">
      <div class="main_title clearfix">
        <h3 class="title">사업비배부기준</h3>
      </div>
      
      <!-- searchform 0202 css 추가 -->
      <div class="search-form-wrap-d">
        <div class="search-item">
          <!--1row-->
          <div class="search-item-inner">      
            <div class="item">
              <p class="title">마감년월 <span class="point">*</span></p>
              <div class="cal-group">
                <input type="text"  class="cal-input" style="width: 80px;">
                <button class="cal"><img src="../img/icon_cal.png"></button>
              </div>
            </div>
            <div class="item">
              <p class="title">배부유형 <span class="point">*</span></p>
              <div>
                <select class="wi100">
                  <option>채널별</option>
                </select>
              </div>
            </div>
            <div class="item">
              <p class="title">사업비배부기초코드</p>
              <div class="clearfix">
                <input type="text" style="width:100px" class="fl mr5">
                <button class="btn_pop_search fl mr5"><span class="blind">조회</span></button>
              </div>
            </div>
            
          </div>
          <!--//1row-->
          <!--2row-->
           <div class="search-item-inner" style="">
            <div class="item">
              <p class="title">마감년월 <span class="point">*</span></p>
              <div class="cal-group">
                <input type="text"  class="cal-input" style="width: 80px;">
                <button class="cal"><img src="../img/icon_cal.png"></button>
              </div>
              </div>
            <div class="item">
              <p class="title">배부유형 <span class="point">*</span></p>
              <div>
                <select class="wi100">
                  <option>채널별</option>
                </select>
              </div>
            </div>
            <div class="item">
              <p class="title">사업비배부기초코드</p>
              <div class="clearfix">
                <input type="text" style="width:100px" class="fl mr5">
                <button class="btn_pop_search fl mr5"><span class="blind">조회</span></button>
              </div>
            </div>
          </div>
          <!--//2row-->
          <!--3row-->
          <div class="search-item-inner">
            <div class="item">
              <p class="title">마감년월 <span class="point">*</span></p>
              <div class="cal-group">
                <input type="text"  class="cal-input" style="width: 80px;">
                <button class="cal"><img src="../img/icon_cal.png"></button>
              </div>
              </div>
            <div class="item">
              <p class="title">배부유형 <span class="point">*</span></p>
              <div>
                <select class="wi100">
                  <option>채널별</option>
                </select>
              </div>
            </div>
            <div class="item">
              <p class="title">사업비배부기초코드</p>
              <div class="clearfix">
                <input type="text" style="width:100px" class="fl mr5">
                <button class="btn_pop_search fl mr5"><span class="blind">조회</span></button>
              </div>
            </div>
          </div>
          <!--//row-->
        </div>
        <div class="search-item-btn"> 
          <!--row 갯수가 1줄일경우  class="" 2줄일 경우 class="p2",  갯수가 3줄일 경우  class="p3"  -->
          <a href="javascript:void(0);" class="p3"><i class="xi-search xi-x"></i> 조회</a> 
        </div>
        </div>
        
      </div>
       <!-- //searchform 0202 css 추가 -->
  
    <!-- btn -->
