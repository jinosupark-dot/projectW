		{ name: 'fcurrScCd', title:'외화구분코드', css:'cell', type: 'text', width: 90, align:'center', editing: false},
		{ name: 'dtPntmScCd', title:'데이터시점구분코드', css:'cell', type: 'text', width: 80, align:'center', editing: false},
		{ name: 'lyepEpdPrsv', title:'전기말계약자이익배당준비금', css:'cell', type: 'text',  width: 150, align:'right', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				
				$result.on('keydown', function(e){
					if(e.which === 13){
						$('#gridDivDwr').jsGrid('updateItem'); 
						$.addCommaNumber(value + '');
						return false;
					}
				});
				
				$result.inputFilter(function(value) {					
