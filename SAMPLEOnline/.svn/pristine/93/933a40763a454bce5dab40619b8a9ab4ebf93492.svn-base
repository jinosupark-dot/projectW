// 조회
function selectIbnrFlfmCflList() {		
	
	/*초기화*/
	minYm = 0;
	maxYm = 0;
	
	var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
	
	if ($.fn.isEmpty(finYm)) {
		$.fn.msgBox('마감년월을 입력하시기 바랍니다.');
		return false;
	}
	
	var reqParam = {};	
	reqParam.finYm = finYm;
	if(addGridTp == 1)
	{		
		reqParam.statusTp = 'u';	
		addGridTp = 0;
	}
	else 
	{
		reqParam.statusTp = ' ';
		addGridTp = 0;
	}		

	$.callAjax(reqParam, '/ca/pr/capr512m/selectContrPrftDvdPrsvRtmBrkdnList.do')
	.done(function(data) {	
		var listData = data.list;  	  	    //서버로 받아온 데이터 리스트
		//그리드 바인딩
		$('#gridDivDwr').jsGrid('loadData', listData).done(function(){
		});
			
		// 0건 그리드 메세지 처리부분
		if(listData.length == 0){
			$.fn.getReturnValue("gridDivDwr");
		}
		
	}).fail(function(data){
		$.fn.msgBox('목록 조회가 실패했습니다.');
	});		
}

//조회
function selectIbnrFlfmCflAfUpList() {		
	
	var reqParam = {};	
	reqParam.fromYm = minYm;
	reqParam.toYm   = maxYm;
	
	var gridData = {};
	
	/*엑셀 업로드후 리스트 조회*/
	$.callAjax(reqParam, '/ca/pr/capr512m/selectContrPrftDvdPrsvRtmBrkdnAfUploadList.do')
	.done(function(data) {	
		var listData = data.list;  	  	    //서버로 받아온 데이터 리스트
		
		gridData = $('#gridDivDwr').jsGrid('loadData', listData);
		
		if(searchTp == 1)
		{
			gridData.status = 'u';
		}
		
		//그리드 바인딩
		$('#gridDivDwr').jsGrid('loadData', listData).done(function(){
		});
		$.fn.msgBox('정상적으로 로드하였습니다.');
		
	}).fail(function(data){
		$.fn.msgBox('목록 조회가 실패했습니다.');
	});		
}


// 저장
function saveGridDataAll() {	
	
	var gridData = {};
	var editRowClass = {};   
	
	
	gridData = $('#gridDivDwr').jsGrid('option', 'data'); 
	editRowClass = $("#gridDivDwr").jsGrid("option", "editRowClass");
	if($("." + editRowClass).length > 0) {
		$("#gridDivDwr").jsGrid("updateItem");
	}
	
	var saveList = [];
	//c,u,d,e 건만 추출 후 저장 처리
	for (var i=0; i<gridData.length; i++) {
		var item = gridData[i];
		
		if (item.status == 'e') {
			if(! isValid(i,item)) { 
				return; 
			}
	
			saveList.push(item);
		} 
		else if (item.status == 'c' || item.status == 'u' || item.status == 'd') {
			
			saveList.push(item);
		}
		
		if(searchTp == 1)
		{
			item.status = 'u'
			saveList.push(item);
		}
	}
	
	//업로드 후 저장할 경우 그리드 데이터가 있는 경우만 저장 처리
	if( gridData.length > 0)
	{	
//		if (sav1eList.length <= 0) {
//			$.fn.msgBox('저장할 데이터가 없습니다.');
//			return;
//		}
		//정상 진행시  
		$.fn.msgBox('데이터를 저장하시겠습니까?', function (obj) {
			if (obj.btn_ok) {
				
				$.callAjax({'list':JSON.stringify(saveList)}, '/ca/pr/capr512m/saveContrPrftDvdPrsvRtmBrkdnList.do')
				.done(function(data) {
					if(data.result == '1') {
						$.fn.msgBox('정상적으로 처리되었습니다.');
						//insAlStactBcontCflDtl(); 기결산금액은 이 화면에서 처리 안하는걸로...
						
						selectIbnrFlfmCflList();					
					}
				}).fail(function(data){
					$.fn.msgBox('데이터 저장이 실패했습니다.');
				});
							
			}
		}, 2);	
	}
	else {
		$.fn.msgBox('저장할 데이터가 없습니다.');
		return;
	}
		
}

//저장
function saveGridDataUploadAll() {	
	
	var gridData = {};
	var editRowClass = {};
	
	gridData = $('#gridDivDwr').jsGrid('option', 'data'); 
	editRowClass = $("#gridDivDwr").jsGrid("option", "editRowClass");
	if($("." + editRowClass).length > 0) {
		$("#gridDivDwr").jsGrid("updateItem");
	}
	
	var saveList = [];
	//c,u,d,e 건만 추출 후 저장 처리
	
	for (var i=0; i<gridData.length; i++) {
		var item = gridData[i];
		
		if (item.status == 'e') {
			if(! isValid(i,item)) { 
				return; 
			}
			
			saveList.push(item);
		} 
		else if (item.status == 'c' || item.status == 'u' || item.status == 'd') {
			
			saveList.push(item);
		}
	}
	
	if (saveList.length <= 0) {
		$.fn.msgBox('저장할 데이터가 없습니다.');
		return;
	}
	
	$.callAjax({'list':JSON.stringify(saveList)}, '/ca/pr/capr512m/saveContrPrftDvdPrsvRtmBrkdnList.do')
	.done(function(data) {
		console.log('result   ====== '+data.result);
		if(data.result == '1') {
			//$.fn.msgBox('정상적으로 처리되었습니다.');			
			searchTp = 1;
			selectIbnrFlfmCflAfUpList();
		}
	}).fail(function(data){
		$.fn.msgBox('데이터 저장이 실패했습니다.');
	});
}

// 행추가
function addGridData() {
	
	var dataList = {};
	var seq = 0;
		
	dataList = $("#gridDivDwr").jsGrid("option", "data");
	seq = dataList.length + 1;
	$('#gridDivDwr').jsGrid('insertItem', 
			{ 
	        	'seq': seq
		      , 'status': 'c'
			  , 'finYm':$.replaceAll($('#finYm').val().trim(),'-','')              /* 마감년월                  */
			  , 'contNo': '88888888'    /* 계약번호                  */
			  , 'cnvlCrncyCd': 'KRW'    /* 환산화폐코드               */
			  , 'crncyCd': 'KRW'        /* 화폐코드                  */
			  , 'fcurrScCd': '1'        /* 외화구분코드               */
			  , 'dtPntmScCd': '9'       /* 데이터시점구분코드           */
			  , 'lyepEpdPrsv': ''       /* 전기말계약자이익배당준비금     */
			  , 'contrQuotaAmt': ''     /* 계약자지분금액              */
			  , 'exdfcAmt': ''          /* 과부족금액                 */
			  , 'preAcumContrDvdt': ''  /* 선적립계약자배당금           */
			  , 'ecpEpdPrsv': ''        /* 당기말계약자이익배당준비금     */
			  , 'epdPrsvStpAmt': ''     /* 계약자이익배당준비금_기시금액   */
			  , 'epdPrsvRplcAmt': ''    /* 계약자이익배당준비금_대체금액   */
			  , 'epdPrsvEpAmt': ''      /* 계약자이익배당준비금_기말금액   */
			  , 'epdPrsvOccuAmt': ''    /* 계약자이익배당준비금_발생금액   */
			  , 'regntEno': ''          /* 등록자사번                 */
			  , 'regDtm': ''            /* 등록일시                  */
			  , 'trtrEno': ''           /* 처리자사번                 */
			  , 'trtDtm': ''            /* 처리일시                  */	
			}
	);	 
	
	//마지막 페이지 이동
	var pageLastText = $("#gridDivDwr").jsGrid("option", "pageLastText");
	$(".jsgrid-pager-nav-button a:contains('" + pageLastText + "')").click();	
}

// 데이터 저장전 validation 체크
function isValid(rowIndex, item) {
	var rowIdx = rowIndex+1;	
	
	if ($.fn.isEmpty(item.finYm)) {
		$.fn.msgBox(rowIdx + '행의 마감년월을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.finYm.trim().length != 6) {
		$.fn.msgBox(rowIdx + '행의 마감년월 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}	
	
	/* 숫자만 입력가능하게 체크 */
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,8}$/.test(item.lyepEpdPrsv) == false){
		$.fn.msgBox(rowIdx + '번째 전기말계약자이익배당준비금은 숫자만 입력하시기 바랍니다.');
		return false;		
	}		
	
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,8}$/.test(item.contrQuotaAmt) == false){
		$.fn.msgBox(rowIdx + '번째 계약자지분금액은 숫자만 입력하시기 바랍니다.');
		return false;		
	}		
	
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,8}$/.test(item.exdfcAmt) == false){
		$.fn.msgBox(rowIdx + '번째 과부족금액은 숫자만 입력하시기 바랍니다.');
		return false;		
	}	
	
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,8}$/.test(item.preAcumContrDvdt) == false){
		$.fn.msgBox(rowIdx + '번째 선적립계약자배당금은 숫자만 입력하시기 바랍니다.');
		return false;		
	}	
	
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,8}$/.test(item.ecpEpdPrsv) == false){
		$.fn.msgBox(rowIdx + '번째 당기말계약자이익배당준비금은 숫자만 입력하시기 바랍니다.');
		return false;		
	}		
	
	return true;
}


// 업로드
function loadExcel() {

	var gridId = 'gridDivDwr';
	
	var paramObj = {};
	paramObj.id = gridId;                    // 그리드 ID
	paramObj.callbackFn = function(data) {   // 그리드 바인딩 후 후처리 함수
		
		if(data.result == '1') {
				
			//$.fn.msgBox('정상적으로 로드하였습니다.');
			
			var gridData = {};
						
			gridData = $('#gridDivDwr').jsGrid('option', 'data');
			
			maxYm = $.replaceAll($('#finYm').val().trim(),'-','');
			minYm = $.replaceAll($('#finYm').val().trim(),'-','');
			
			for (var i=0; i<gridData.length; i++) {
				var item = gridData[i];
				item.status = 'c'; //엑셀업로드시 중복 데이터 입력시 체크하기 위해 신규 입력으로 변경
				tmpMaxYm = gridData[i].finYm;
				tmpMinYm = gridData[i].finYm;
				
				if(tmpMaxYm > maxYm)
				{
					maxYm = tmpMaxYm;	
				}
				
				if(tmpMinYm < minYm)
				{
				    minYm = tmpMinYm; 	
				}
			}
			
		}
		
		af_up();
	};
	
	$.fn.loadGridExcel(paramObj);
}

/*엑셀업로드후 저장*/
function af_up() {
	
	saveGridDataUploadAll();
		
}
