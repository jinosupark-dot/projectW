/*******************************************************************
**   시스템명   : (부채결산)IFRS17
**   업무명     : RA상관계수 관리
**   설명       : 상관계수 수정입력 화면
**   최조작성자  : 조예리
**   최조작성일  : 2021.03.02
**   최종변경일  : 2021.06.18
**   개정이력    :
**    - 조예리 2021.03.02 신규작성
**    - 조예리 2021.03.18 1차검증
**    - 조예리 2021.04.27 2차표준화 
**    - 조예리 2021.06.18 3차표준화  
*******************************************************************/

//전역변수 선언
var initObject = null;					//수정전 원데이터
let today = new Date();
let year = today.getFullYear();
let month = ((today.getMonth() + 1) < 10) ? "0" + (today.getMonth() + 1) : today.getMonth() + 1;
const toYm = year + "-" + month;
var perBtnId = ["btn_save"];

$(document).ready(function(){
	
	//권한별 버튼제어
	//button permission
	var arrPerBtn = new Array();
	for(var i=0; i<perBtnId.length; i++){
		var perBtn = new Object();
		perBtn.btnId  = "#" + perBtnId[i];
		perBtn.action = "R";
		arrPerBtn.push(perBtn);
	}
	$.fn.setBtnPermission(arrPerBtn);
	
	//툴팁 및 메뉴ID
	$("#imgToolTip").attr("title", parent.viewPath);
	$($("h3")[0]).text($.fn.getMenuNm()+" :: ["+$.fn.getMenuId()+"]");
	
	//event 초기화
	initEvent();
	
	//조회
	initGrid();	

	//검색조건 마감년월 포커스 이동
	$("#finYm").focus();
});

/**
 * @설명: event 초기화
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function initEvent() {
	//마감년월 입력창 blur
	$('#finYm').on('blur', function(e) {
		//빈값 체크
		if($.fn.isEmpty(this.value)) {
			return;
		}
		
		//날짜형식 체크
		if($.isValidYm(this.value)) {
			$(this).val($.fn.monthFormat(this.value));
		} else {
			$.fn.msgBox('마감년월의 날짜 형식이 맞지 않습니다. 다시 입력해주세요.');
			$(this).focus();
		}
	});
	
	//조회
	initGrid();
	
	//마감년월 달력버튼 click
	$("#btn_finYm").on("click", function(e){
		$("#finYm").datepicker("show");
	});
	
	//조회
	$('#btn_search').on('click', function(e){
		selectCecntPsnBrkdnList();
	});
	
	//저장
	$('#btn_save').on('click', function(e){
		saveGridDataAll();
	});
	
	//행추가
	$('#btn_addGrid').on('click', function(e){
		addGridData();
	});
	
	//양식다운로드
	$('#btn_exportExcel').on('click', function(e){
		var gridId = 'gridDiv';
		var fileName = '상관계수행렬내역_업로드양식.xlsx';

		var paramObj = {};
		paramObj.id = gridId;
		paramObj.fileName = fileName;         // 다운로드할 파일명
		paramObj.applyItemTemplate = false;   // 그리드 컬럼 디스플레이 포멧터 적용 출력 여부(해당엑셀로 Import하기 위해서는 false)
		$.fn.exportGridExcel(paramObj);
	});

	
	//엑셀업로드
	$("#btn_loadExcel").on("click", function(e){
		var paramObj = {};
		var reqParam = {};
		reqParam.finYm = finYm;

		var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
		
		if ($.fn.isEmpty(finYm)) {
			$.fn.msgBox('마감년월을 입력하시기 바랍니다.');
			return false;
		}	

		var maxFinYm = ""; //마지막 마감년월 조회

		//엑셀 업로드 하려는 마감년월보다 이후 마감년월 존재여부 확인
		$.callAjax(reqParam, "/ca/pr/capr311m/selectMaxFinYm.do",{async:false})
		.done(function(data) {
			
			//마지막 마감년월 조회
			maxFinYm = data.result.aplcStrYm;
			
			console.log("maxFinYm : "+maxFinYm);
			
			//저장하려는 마감년월과 비교
			if(maxFinYm >= finYm){
				//마지막 업로드 년월 다음달 계산
				var calcDate = new Date(maxFinYm.substr(0,4), maxFinYm.substr(4,2), "1");
				var year = calcDate.getFullYear();
				var month = '' + (calcDate.getMonth()+1);			
				if (month.length < 2) month = '0' + month;
				
				$.fn.msgBox(finYm.substr(0,4) + '년 ' + finYm.substr(4,2) + '월' +' 기준의 데이터를 저장할수 없습니다. \n 업로드 데이터의 마감년월 기준은 '+year+ '년 ' + month + '월' +'부터 저장 가능합니다.');
				return false;
			}else{
				paramObj.id = "gridDiv";					//그리드 ID
				paramObj.callbackFn = function(data) {		//그리드 바인딩 후 후처리 함수
					if(data.result == "1") {
						$.fn.msgBox("정상적으로 로드하였습니다.");
		
						//엑셀데이터 형식 맞추기
						loadGridSetting();
					}
				};
				$.fn.loadGridExcel(paramObj);		
			}
		}).fail(function(data) {
			console.log("fail to selectMaxFinYm!!!!");
		});
	});

	//조회조건 엔터키 조회
	$("#finYm").on("keypress", function(e) {
		if(e.keyCode == 13) {
			$("#btn_search").click();
			return false;
		}
	});
}


/**
 * @설명: jsGrid 빈 테이블 생성 
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function initGrid(){
	// jsGrid 빈 테이블 생성
	var gridObject = new ComJsGrid({
		id: 'gridDiv',
		height: 600,
		editing: true,
		sorting: true,
		paging: true,
		selectHiglight:false,
		deleteConfirm: '삭제하시겠습니까?',
		controller : {
			updateItem : function(item) {	//Edit모드에서 적용 아이콘 또는 updateItem API를 이용시 진입
				var status = 'u';	//수정
				if(item.status == 'c' || item.status == 'e') {	//신규, 엑셀로드는  c, e상태 유지 후 데이터 수정
				} else if(item.status == 'dd'){	//삭제신청으로 요청되면 '삭제'로 최정 변경처리
					item.status = 'd';
				} else {
					item.status = status;
				}
				return item;
			},
			deleteItem : function(item) { //grid 삭제 아이콘 클릭 또는 deleteItem API이용시 진입
				//deleteItem에서 dd로 -> updateItem에서 최종 d상태가 됨.
				var status = 'dd';	//삭제 신청
				if(item.status == 'c' || item.status == 'e') {	//신규, 엑셀로드 입력대상건으로 그리드만 삭제처리
					jsGridDeletionFailed = false;
				} else  {	//u,d 는 삭제 상태로 처리 -> updateItem에서 최종  삭제대기가 됨.
					jsGridDeletionFailed = true;
					item.status = status;
					$("#gridDiv").jsGrid("updateItem", item);
					return item;
				}
			}			
		},
		onItemEditing: function(args) {	//Grid Edit모드 진입시 처리
			if(typeof event === "undefined") {
				args.cancel = true;
				return;
			}
			
			//체크박스는 Edit 모드 취소
			var targetElem = event.srcElement;
			if( targetElem.outerHTML.indexOf("check") > 0) {
				args.cancel = true;
			}
			
			//delete 상태 스킵
			if( args.item.status == 'd') {
				args.cancel = true;
			}
			
		},
	   fields: [
		{ name: 'aplcStrYm', title:'적용시작년월', css:'cell', type: 'text', width: 100, align:'center', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				// 신규 외엔 수정 불가
				if(item.status != 'c') {
					$result.attr('readonly', 'true');
				}
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				}).on("input keyup", function(e) {
					//숫자입력만 가능
					var val = $(this).val();
					$(this).val(val.replace(/[^\d]/g, "").substr(0,6));
				});
				
				return $result;
			}, 
			validate: [{validator:"required", message:"[적용시작년월] 필수 입력 항목입니다."}
						, {validator:"minLength", param:6, message:"[적용시작년월] 입력 자리수는 6자리입니다."}
						, {validator:"maxLength", param:6, message:"[적용시작년월] 입력 자리수는 6자리입니다."}
						, {validator:'pattern', message:'[적용시작년월] 날짜 형식이 맞지 않습니다.', validator:function(value) {return $.isValidYm(value);}}
						]
		},
		{ name: 'aplcEndYm', title:'적용종료년월', css:'cell', type: 'text', width: 100, align:'center', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				// 신규 외엔 수정 불가
				if(item.status != 'c' && item.status != 'e') {
					$result.attr('readonly', 'true');
				}
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				});
				
				return $result;
			}, 
			validate: [{validator:"required", message:"[적용종료년월] 필수 입력 항목입니다."}
			, {validator:"minLength", param:6, message:"[적용종료년월] 입력 자리수는 6자리입니다."}
			, {validator:"maxLength", param:6, message:"[적용종료년월] 입력 자리수는 6자리입니다."}
			, {validator:'pattern', message:'[적용종료년월] 날짜 형식이 맞지 않습니다.', validator:function(value) {return $.isValidYm(value);}}
			]
		},
		{ name: 'rowRiskTypScCd', title:'리스크유형(행)', css:'cell', type: 'text', width: 110, align:'center', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
				// 신규 외엔 수정 불가
				if(item.status != 'c' && item.status != 'e') {
					$result.attr('readonly', 'true');
				}
				
				$result.on("keydown", function(e){
					if(e.which === 13){
						$("#gridDiv").jsGrid("updateItem");
						return false;
					}
				}).on("input keyup", function(e) {
					//숫자입력만 가능
					var val = $(this).val();
					$(this).val(val.replace(/[^\d]/g, "").substr(0,3));
				});
				
				return $result;
			},
			validate: [{validator:"required", message:"[리스크유형(행)] 필수 입력 항목입니다."}
				, {validator:'pattern', message:'[리스크유형(행)] 숫자 형식이 맞지 않습니다.', validator:function(value) {return $.isNumber(value);}}
				]
		},
		{ name: 'colRiskTypScCd', title:'리스크유형(열)', css:'cell', type: 'text', width: 90, align:'center', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
			// 신규 외엔 수정 불가
			if(item.status != 'c' && item.status != 'e') {
				$result.attr('readonly', 'true');
			}
			
			$result.on("keydown", function(e){
				if(e.which === 13){
					$("#gridDiv").jsGrid("updateItem");
					return false;
				}
			}).on("input keyup", function(e) {
				//숫자입력만 가능
				var val = $(this).val();
				$(this).val(val.replace(/[^\d]/g, "").substr(0,3));
			});
			
			return $result;
			}, 
			validate: [{validator:"required", message:"[리스크유형(열)] 필수 입력 항목입니다."}
					, {validator:'pattern', message:'[리스크유형(열)] 숫자 형식이 맞지 않습니다.', validator:function(value) {return $.isNumber(value);}}
					]
		},
		{ name: 'cecnt', title:'상관계수', css:'cell', type: 'text', width: 90, align:'right', editTemplate:function(value, item) {
			var $result = jsGrid.fields.text.prototype.editTemplate.call(this, value, item);
			
			$result.on("click", function() {
				$(this).select();
			});
			
			$result.inputFilter(function(value) {
				
				if($.isNumberFormat(value)) {
					return true;
				} else {
					return false;
				}
			})
			
			return $result;
			}
		},
		{ name: 'regntEno', title:'등록자사번', css:'cell', type: 'text',  width: 100, align:'center', editing: false},
		{ name: 'regDtm', title:'등록일', css:'cell', type: 'text',  width: 100, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.dateFormat(value, "-");			
		}},
		{ name: 'trtrEno', title:'처리자사번', css:'cell', type: 'text',  width: 100, align:'center', editing: false},
		{ name: 'trtDtm', title:'처리일', css:'cell', type: 'text',  width: 100, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.dateFormat(value, "-");			
		}},
		{ name: 'status', title:'상태', css:'cell', type: 'text', width: 30, align:'center', editing: false, itemTemplate:function(value, item) {
			return $.fn.getGridRowStatusName(value);			
		}}] 
		
	});	

	//그리드 생성
	gridObject.gridCreate();
}


/**
 * @설명: 조회
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function selectCecntPsnBrkdnList() {
	var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
		
	var reqParam = {};
	reqParam.finYm = finYm;

	$.callAjax(reqParam, '/ca/pr/capr311m/selectCecntPsnBrkdnList.do')
	.done(function(data) {	
		var listData = data.list;  	  	    //서버로 받아온 데이터 리스트
		//그리드 바인딩		
		$('#gridDiv').jsGrid('reset');
		$('#gridDiv').jsGrid('loadData', listData).done(function(){
		});
		
		//0건 그리드 메시지 처리
		if(listData.length == 0){
			$.fn.getReturnValue("gridDiv");
			
		}
			
	}).fail(function(data){
		$.fn.msgBox('목록 조회가 실패했습니다.');
	});		
}


/**
 * @설명: 저장버튼 클릭시 저장
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function saveGridDataAll() {
	
	var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
	
	if ($.fn.isEmpty(finYm)) {
		$.fn.msgBox('마감년월을 입력하시기 바랍니다.');
		return false;
	}
	
	//그리드 edit모드가 있을 경우, 수정사항 반영
	var editRowClass = $("#gridDiv").jsGrid("option", "editRowClass");
	if($("." + editRowClass).length > 0) {
		$("#gridDiv").jsGrid("updateItem");
	}
	
	var saveList= new Array();	//저장대상 배열 선언
	var gridData = $("#gridDiv").jsGrid("option", "data");	//전체 데이터
	var excelYn = false;		//엑셀업로드여부 확인
	
	//c,u,d,e 건만 추출
	for(var i = 0; i < gridData.length; i++) {
		var item = gridData[i];
		if(item.status == "c" || item.status == "u" || item.status == "d" || item.status == "e") {
			//유효값체크
			if(!isValid(i, item)) { return; }
			
			for(var key in item) {
				
				//리스크유형(행), 리스크유형(열) 한자리인 경우 두자리로 세팅
				if(key == 'rowRiskTypScCd' || key == 'colRiskTypScCd'){
					if(item[key].length == 1){ //자릿수가 한자리인 경우 두자리로 세팅
						item[key] = "0"+item[key];
					}
				}else{
					item[key] = $.trim(item[key]);
				}
			}
			
			saveList.push(item);
		}

		//엑셀업로드여부 확인
		if(item.status == "e"){
			excelYn = true;
		}
	}
	
	if(saveList.length == 0) {
		$.fn.msgBox("저장할 대상이 없습니다.");
		return;
	}
	

	var confirmMsg = "데이터를 저장하시겠습니까?";	//저장시 확인메시지
	var dataYn = false;
	//엑셀업로드여부 확인
	if(excelYn){
		var reqParam = {};
		reqParam.finYm = finYm;		

		var maxFinYm = ""; //마지막 마감년월 조회

		//엑셀 업로드 하려는 마감년월보다 이후 마감년월 존재여부 확인
		$.callAjax(reqParam, "/ca/pr/capr311m/selectMaxFinYm.do",{async:false})
		.done(function(data) {
			
			//마지막 마감년월 조회
			maxFinYm = data.result.aplcStrYm;
			
			//저장하려는 마감년월과 비교
			if(maxFinYm >= finYm){
				//마지막 업로드 년월 다음달 계산
				var calcDate = new Date(maxFinYm.substr(0,4), maxFinYm.substr(4,2), "1");
				var year = calcDate.getFullYear();
				var month = '' + (calcDate.getMonth()+1);			
				if (month.length < 2) month = '0' + month;
				
				$.fn.msgBox(finYm.substr(0,4) + '년 ' + finYm.substr(4,2) + '월' +' 기준의 데이터를 저장할수 없습니다. \n 업로드 데이터의 마감년월 기준은 '+year+ '년 ' + month + '월' +'부터 저장 가능합니다.');
				return false;				
			}else{
				confirmMsg = "업로드한 상관계수 데이터를 저장하시겠습니까?";
				
				//데이터저장
				saveGridData(confirmMsg, saveList);				
			}
		}).fail(function(data) {
			console.log("fail to selectMaxFinYm!!!!");
		});
	}else{
		//데이터 저장
		saveGridData(confirmMsg, saveList);
	}
}


/**
 * @설명: 데이터 저장
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function saveGridData(confirmMsg, saveList) {
	
	//저장
	$.fn.msgBox(confirmMsg, function (obj) {
		if (obj.btn_ok) {
			$.callAjax({'list':JSON.stringify(saveList)}, '/ca/pr/capr311m/saveCecntPsnBrkdnList.do')
			.done(function(data) {
				if(data.result == '1') {
					$.fn.msgBox('정상적으로 처리되었습니다.');
					selectCecntPsnBrkdnList();
				}
			}).fail(function(data){
				$.fn.msgBox('데이터 저장이 실패했습니다.');
			});
		}
	}, 2);		
}


/**
 * @설명: 행추가
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function addGridData() {

	//status컬럼은 그리드 상태 핸들링 하기 위함.(c:신규, u:수정, d:삭제, e:엑셀로드)
	$('#gridDiv').jsGrid('insertItem', 
		{ 
		  'aplcStrYm': $.replaceAll($('#finYm').val().trim(),'-',''),
		  'status': 'c',		  
		  'aplcEndYm': '999912',
		  'rowRiskTypScCd': '',
		  'colRiskTypScCd': '',
		  'cecnt': '',
		  'regntEno':'',
		  'regDtm': '',
		  'trtrEno':'',
		  'trtDtm': ''
		}
	);
	
	//마지막 페이지 이동
	var pageLastText = $("#gridDiv").jsGrid("option", "pageLastText");
	$(".jsgrid-pager-nav-button a:contains('" + pageLastText + "')").click();
}

/**
 * @설명: 데이터 저장전 validation 체크
 * @최초작성자: 62000290
 * @최초작성일: 2021. 03. 02.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 03. 02. 최초작성
 */
function isValid(rowIndex, item) {
	var rowIdx = rowIndex+1;
	
	if ($.fn.isEmpty(item.aplcStrYm)) {
		$.fn.msgBox(rowIdx + '행의 적용시작년월을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.aplcStrYm.trim().length != 6) {
		$.fn.msgBox(rowIdx + '행의 적용시작년월 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}
	
	if ($.fn.isEmpty(item.aplcEndYm)) {
		$.fn.msgBox(rowIdx + '행의 적용종료년월을 입력하시기 바랍니다.');
		return false;
	}
	
	if (item.aplcEndYm.trim().length != 6) {
		$.fn.msgBox(rowIdx + '행의 적용종료년월 입력 자리수를 확인해 주시기 바랍니다.');
		return false;
	}	
	
	if ($.fn.isEmpty(item.colRiskTypScCd)) {
		$.fn.msgBox(rowIdx + '행의 리스크유형(행)을 입력하시기 바랍니다.');
		return false;
	}
	
	if ($.fn.isEmpty(item.colRiskTypScCd)) {
		$.fn.msgBox(rowIdx + '행의 리스크유형(열)을 입력하시기 바랍니다.');
		return false;
	}
	
	//상관계수는 부동소수점도 허용되는지 확인함
	if(/^[-]?[0-9]*\.?\d{0,4}$/.test(item.cecnt) == false){
		$.fn.msgBox(rowIdx + '상관계수는 숫자만 입력하시기 바랍니다.');
		return false;		
	}
	return true;
}

/**
 * @설명: 업로드 데이터 그리드 세팅
 * @최초작성자: 62000290
 * @최초작성일: 2021. 04. 12.
 * @최종변경일: 
 * @매개변수: @returns
 * @반환값: 
 * @개정이력: 
 *  62000290 2021. 04. 12. 최초작성
 */
function loadGridSetting() {

	console.log("loadGridSetting");
	var finYm = $.replaceAll($('#finYm').val().trim(),'-','');  // 마감년월
	var saveList= new Array();	//저장대상 배열 선언
	var gridData = $("#gridDiv").jsGrid("option", "data");	//전체 데이터
	
	//c,u,d,e 건만 추출
	for(var i = 0; i < gridData.length; i++) {
		var item = gridData[i];
		console.log("item",item);
		if(item.status == "c" || item.status == "u" || item.status == "d" || item.status == "e") {
						
			for(var key in item) {
				//적용시작년월을 마감년월로 교체
				if(key == 'aplcStrYm'){
					item[key] = finYm;	
				//적용종료년월을 마감년월로 교체
				}else if(key == 'aplcEndYm'){
					item[key] = '999912';
				//적용시작년월을 마감년월로 교체
				}else if(key == 'rowRiskTypScCd' || key == 'colRiskTypScCd'){
					if(item[key].length == 1){ //자릿수가 한자리인 경우 두자리로 세팅
						item[key] = "0"+item[key];
					}
				}else{
					item[key] = $.trim(item[key]);
				}
			}
			
			saveList.push(item);
		}
	}
	
	//그리드 바인딩		
	$('#gridDiv').jsGrid('reset');
	$('#gridDiv').jsGrid('loadData', saveList).done(function(){
	});
}

//숫자형 (음수,소수점) 가능
$.isNumberFormat = function(value){return /^[-]?\d*\.?\d{0,4}$/.test(value);};