<body>
 <!-- content01-->
  <div id="contentWrap" class="clearfix">
    <div class="content_header">
      <div class="main_title clearfix">
        <h3 class="title">Audit Trail - 잔액명세</h3>
      </div>
      <!-- searchform -->
      <div class="search-form-wrap">
        <div class="search-item">
          <div class="search-item-inner">
            <div class="item">
              <p class="title">마감년월</p>
              <div class="cal-group">
                <input type="text"  class="cal-input" style="width: 80px;">
                <button class="cal"><img src="../img/icon_cal.png"></button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- searchform // --> 

      <!-- table -->
      <h4 class="title mt50">잔액명세</h4>
      <div class="tableWrap ">
        <table class="tableA">
          <thead>
            <tr>
              <th colspan="6">검증항목</th>
              <th colspan="7">JR금액</th>
              <th>SPA</th>
              <th rowspan="2">차이(SAP-JR)</th>
            </tr>
            <tr>
              <th>재무제표항목/계정과목코드</th>
              <th>1</th>
              <th>2</th>
              <th>3</th>
              <th>4</th>
              <th>계정과목</th>
              <th>집합별 BEL 변동</th>
              <th>집합별 RA변동분석내역</th>
              <th>원천테이블3</th>
              <th>원천테이블4</th>
              <th>원천테이블5</th>
              <th>미수미지급</th>
              <th>null</th>
              <th>N1</th>
            </tr>
          </thead>
          <tbody>
            <!--합계일경우 total class 추가-->
            <tr>
              <td class="">
                <div class="clearfix">
                  <span class="fl total">f17A201000000</span>
                  <span class="fr total"></span>
                </div>
              </td>
              <td colspan="5" rowspan="4"></td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
              <td class="tr total"> 0</td>
            </tr>  
            <!--합계일경우//-->
            <tr>
              <td>
                <div class="clearfix">
                  <span class="fl">f17A201000000</span>
                  <span class="fr"></span>
                </div>
              </td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
            </tr>  
           <tr>
              <td>
                <div class="clearfix">
                  <span class="fl">f17A201000000</span>
                  <span class="fr"></span>
                </div>
              </td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
            </tr>
            <tr>
              <td>
                <div class="clearfix">
                  <span class="fl"></span>
                  <span class="fr">1661020101</span>
                </div>
              </td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
              <td class="tr"> 0</td>
            </tr>                     
