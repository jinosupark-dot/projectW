/*행추가*/
.btn-grid-add{background: #877475;
	background: -moz-linear-gradient(top, #877475 0%, #735f60 100%);
	background: -webkit-linear-gradient(top, #877475 0%, #735f60 100%);
	background: linear-gradient(to bottom, #877475 0%, #735f60 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#877475', endColorstr='#735f60', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #877475;
	line-height: 25px;
	color: #ececec;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
	cursor: pointer; }
.btn-grid-add:hover{
		background: #755153;
		border-radius: 2px;
		border: 1px solid #654d4c;
		color: #fff;
		padding: 0px 7px;
		display: inline-block;
		line-height: 25px;
		font-size: 12px;
	
	}

.btn-grid-add span{background: url(../img/btn_icon_plus.png) 0 3px no-repeat;padding:0 0 0 16px}

