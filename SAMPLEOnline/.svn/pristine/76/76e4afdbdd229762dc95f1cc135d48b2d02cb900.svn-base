.btn-save-d{
	background: #909090;
	background: -moz-linear-gradient(top, #909090 0%, #7b7b7b 100%);
	background: -webkit-linear-gradient(top, #909090 0%, #7b7b7b 100%);
	background: linear-gradient(to bottom, #909090 0%, #7b7b7b 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#909090', endColorstr='#7b7b7b', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #909090;
	line-height: 25px;
	color: #ececec;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
	cursor:Default;
}
.btn-save-d span{background: url(../img/btn_save.png) 0 0  no-repeat;padding: 0 0 0 23px;}


/*신규센터 불러오기*/
.btn-new-center {
	background: #4b5378;
	background: -moz-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: -webkit-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: linear-gradient(to bottom, #4b5378 0%, #3b4263 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#4b5378', endColorstr='#3b4263', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #3b4263;
	line-height: 25px;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
}
.btn-new-center span{background: url(../img/btn_new_center.png) 0 0  no-repeat;padding: 0 0 0 23px;}
.btn-new-center:hover{
	background: #4b5378;
	background: -moz-linear-gradient(top, #3b4263 0%, #4b5378 100%);
	background: -webkit-linear-gradient(top, #3b4263 0%, #4b5378 100%);
	background: linear-gradient(to bottom, #3b4263 0%, #4b5378 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#3b4263', endColorstr='#4b5378', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #3b4263;
	line-height: 25px;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
}

.btn-new-center-d{
	background: #909090;
	background: -moz-linear-gradient(top, #909090 0%, #7b7b7b 100%);
