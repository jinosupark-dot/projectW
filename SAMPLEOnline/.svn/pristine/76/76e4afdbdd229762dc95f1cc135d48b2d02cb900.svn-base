/* JS Grid */
.jsgrid-selected-row>.jsgrid-cell {	background-color:#FFDFE0; border-color:#FFDFE0;}

tr.total td.jsgrid-cell { background-color: #FFEDE6 !important;}
tr.sub-total td.jsgrid-cell { background-color: #FFEDE6 !important;}
tr.highlight td.jsgrid-cell { background-color: #FD7B7E !important; color:white;}

.jsgrid-pager-container { text-align: center;}
.jsgrid-filter-row>.jsgrid-cell, .jsgrid-header-row>.jsgrid-header-cell, .jsgrid-insert-row>.jsgrid-cell{border-bottom:1px solid #424242;;border-right:1px solid #c5c5c5}
.jsgrid-filter-row>.jsgrid-cell input{height:25px !important}
.jsgrid-filter-row>.jsgrid-cell select{height:25px !important}


/*loadingbar*/
#loading {background:rgba(0,0,0,0.65);position:fixed;width:100%;height:100%;z-index:999;top:0;left:0;}
#loading .loading_inner {height:100vh;position: relative;padding-top:50vh;text-align:center;color:#fff;}
#loading .loading_inner i {display:block;margin-bottom:10px;}

/*popup*/
.popupWrap {width:500px;margin:10% auto;background:#fff;border:3px solid #e53c2c;position: relative;z-index: 9999999999999999;}
.popupWrap.full {width:650px;}
.popupWrap .popup_header {background:#f3eae3 url(../img/common/popup_header_bg.png) no-repeat 0 50%;border-bottom:1px solid #ee3124;padding:15px 30px;}
.popupWrap .popup_header h3 {color:#000;}
.popupWrap .popup_body {padding:15px 20px;}
.popupWrap .popup_body h4 {color:#000;margin-bottom:10px;}
.popupWrap .popup_body .popup_content {background:#f1f2f4;padding:15px;}
.popupWrap .popup_footer {text-align:center;padding-bottom:15px;}
.popupWrap .popup_footer input[type=button],
.popupWrap .popup_footer a {color:#fff;background: #4b5378;
	background: -moz-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: -webkit-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: linear-gradient(to bottom, #4b5378 0%, #3b4263 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#4b5378', endColorstr='#3b4263', GradientType=0 );
	border-radius: 2px;padding: 0px 7px;font-size: 12px;line-height: 25px;}

.popupWrap .popup_footer input[type=button]:disabled,
.popupWrap .popup_footer a {background: #909090;
		background: -moz-linear-gradient(top, #909090 0%, #7b7b7b 100%);
		background: -webkit-linear-gradient(top, #909090 0%, #7b7b7b 100%);
		background: linear-gradient(to bottom, #909090 0%, #7b7b7b 100%);
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#909090', endColorstr='#7b7b7b', GradientType=0 );
		border-radius: 2px;
		border: 1px solid #909090;
		line-height: 25px;
		color: #ececec;
		padding: 0px 7px;
		display: inline-block;
		font-size: 12px;
		cursor:Default;}


.popupDim {background:rgba(0,0,0,0.65);position:fixed;width:100%;height:100%;z-index:9999;top:0;left:0;}

/*popup-window*/
.popupWrap-win {background:#fff;border:3px solid #e53c2c;position: relative;z-index: 9999999999999999;height:100%}/*ie height값 100%설정*/ 
.popupWrap-win .Small {width:300px;}
.popupWrap-win .Large {width:800px;}
.popupWrap-win .full {width:650px;}
.popupWrap-win .popup_header {background:#f3eae3 url(../img/common/popup_header_bg.png) no-repeat 0 50%;border-bottom:1px solid #ee3124;padding:15px 30px;}
.popupWrap-win .popup_header h3 {color:#000;}
.popupWrap-win .popup_body {padding:15px 20px;}
.popupWrap-win .popup_body h4 {color:#000;margin-bottom:10px;}
.popupWrap-win .popup_body .popup_content {background:#f1f2f4;padding:15px;}
.popupWrap-win .popup_footer {text-align:center;padding-bottom:15px;}
.popupWrap-win .popup_footer input[type=button],
.popupWrap-win .popup_footer a {color:#fff;background: #4b5378;
	background: -moz-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: -webkit-linear-gradient(top, #4b5378 0%, #3b4263 100%);
	background: linear-gradient(to bottom, #4b5378 0%, #3b4263 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#4b5378', endColorstr='#3b4263', GradientType=0 );
	border-radius: 2px;padding: 0px 7px;font-size: 12px;line-height: 25px;}


/* 에러페이지 */
.error_content {
	position:absolute; 
	text-align : center;  
	top: 50%; 
	left:0; 
	right:0; 
	margin-top : -18em;
}
.error_content img {
	width : 20em;
}
.error_content p {
	margin-top : 1.5em; 
	margin-bottom : .75em;
	font-size : 2em;
}
.error_content a{
	font-size : 1.5em; 
	color : #0084e9; 
	font-weight : bold; 
	cursor:pointer;
}

.cal{display:inline;height:21px;background:#786465}
.cal img{width:12;height:12px}
.cal:hover{background:#8e4d50}
.cal:disabled{background:#808080}

.cal-group{clear:both;content:'';display:block}
.cal-group input.cal-input{display:block;float:left;width:100px !important}
.cal-group button.cal{display:block;float:left}
.btn_pop_search{display:inline;width:24px;height:21px;background: url(../img/btn_icon_search.png) 50% 50% no-repeat}
.test{display: table;width:100%;border-collapse: collapse;box-sizing:border-box;}
.text{font-size:13px;line-height:15px;padding:2px 0 3px;display: inline-block;margin: 0 5px 0 0 ; }

