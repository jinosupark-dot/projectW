@charset "utf-8";

#wrap  {width:100%;min-width:1280px; color:#222; margin:0;padding:0;position:relative;}
#wrap:after {content:"";display:block;clear:both}
.inner {width:100%;height:calc(100% - 40px);position:relative;margin:0;padding:0;min-height:555px}
.inner:after {content:"";display:block;clear:both}


/*ifrmae*/
.iframe_header {border:0;width:100%;height:51px;}
.iframe_contentDiv {display:inline-block;width:calc(100% - 168px);height:calc(100% - 51px);}
.iframe_content {border:0;width:100%;height:100%;}

/* Content */
section { margin:0;padding:0; width:100%;min-width:1280px;height:100%;box-sizing:border-box;overflow-y:auto;overflow-x:auto;}
section:after {content:"";display:block;clear:both}

#contentWrap {
/* 	float:right; */
/* 	width:calc(100% - 168px); */
	width:100%;padding:40px 30px 40px 30px;z-index:1;position:relative;height:100%;overflow-y:auto;overflow-x:auto;	}
#contentWrap:after {content:"";display:block;clear:both}

.dpn{display: none !important;}


.tableA {clear: both;display: table;width:100%;border-collapse: collapse; border-top:2px solid #424242;border-bottom:none;border-left:1px solid #c5c5c5;border-right:1px solid #c5c5c5;margin:0px 0 0px 0;box-sizing:border-box;}
.tableA thead th {background: #fcfcfc; 
background: -moz-linear-gradient(top, #fcfcfc 0%, #c5c5c5 100%);
background: -webkit-linear-gradient(top, #fcfcfc 0%,#c5c5c5 100%); 
background: linear-gradient(to bottom, #fcfcfc 0%,#c5c5c5 100%); 
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#fcfcfc', endColorstr='#c5c5c5',GradientType=0 );padding:6px 10px;font-size:13px;color:#444444;border-left:1px solid #c5c5c5;border-right:1px solid #c5c5c5;text-align:center;font-weight:600;}
.tableA thead {border-bottom:1px solid #424242}
.tableA tbody td {border-bottom:1px solid #f3f3f3;border-right:1px solid #f3f3f3;border-left:1px solid #f3f3f3;color:#444444;font-size:13px;padding:6px 10px;background:#fff;box-sizing:border-box;vertical-align: middle;}
.tableA tbody tr:nth-child(even) td {background:#f7f7f7;}
.tableA tbody tr:hover td {background:#ece0d6;}
.tabelA tbody tr .total{color:#b9261c !important;}
.tabelA tbody tr .total td{border-bottom:1px solid #e2e2e2;color:#b9261c !important;font-size:13px;padding:6px 10px;background:#f9f5f1;box-sizing:border-box;vertical-align: middle;}
.tableA tfoot td{border-bottom:1px solid #e2e2e2;color:#b9261c;font-size:13px;padding:6px 10px;background:#f8f1eb;box-sizing:border-box;vertical-align: middle;}
.tableA tfoot th{border-bottom:1px solid #e2e2e2;color:#b9261c;font-size:13px;padding:6px 10px;background:#f8f1eb;box-sizing:border-box;vertical-align: middle;}

/*table-detail*/
.table-detail {font-size:12px;clear: both;display: table;width:100%;border-collapse: collapse; border-top:2px solid #424242;border-bottom:none;border-left:1px solid #c5c5c5;border-right:1px solid #c5c5c5;margin:0px 0 0px 0;box-sizing:border-box;}
.table-detail tbody tr th {border-bottom:1px solid #cfcfcf;background: #e9e9e9;padding:6px 10px;font-size:13px;color:#444444;border-right:0px solid #c5c5c5;text-align:left;font-weight:600;}
.table-detail tbody tr td {border-bottom:1px solid #cfcfcf;color:#444444;font-size:13px;padding:6px 10px;background:#fff;box-sizing:border-box;vertical-align: middle;}
.table-detail tbody tr td:last-child{border-right: 1px solid #cfcfcf;}
.table-detail .point {color:#ee2d23;padding:0 5px}

/*login*/
.login_header {border-bottom:2px solid #3b4263;padding:40px 50px}
.login_footer {padding:30px 50px;position:relative;}
.login_footer span {color:#f26c4a;}
.login_footer p {line-height:150%;color:#7a7890;font-size:12px;}
.login_footer p.copyright {position:absolute;right:50px;top:30px;}
#login_wrap {position:relative;width:100%;background:url(../img/login/login_visual.png) no-repeat left top;padding:50px 50px 0px 50px;height:auto;}
#login_logo_wr {width:200px; float:right; margin-right:15px; margin-top:-5px;} /* 추가 20250820 */

.login_box .login_inner  {background:rgba(255,255,255,1);padding:45px 65px;float:right;width:40%;}
.login_box h2 {font-weight:700;font-size:25px;color:#3b4263;line-height:1em;margin-bottom:25px;}
.login_box .id_input {border:1px solid #cccccc;background:#fff;height:38px;padding:0 5px;margin-bottom:10px;}
.login_box .pw_input {border:1px solid #cccccc;background:#fff;height:38px;padding:0 5px;margin-bottom:10px;}
.login_box input[type=text],
.login_box input[type=password] {border:none;line-height:36px;height:36px;width:100%;font-size:15px;}
.login_box label {color:#808080;vertical-align:top;font-size:14px;}
.login_box input[type=button] {display:block;width:100%;padding:10px; text-align:center;color:#fff;font-weight:600;font-size:16px;margin-bottom:10px;border:1px solid #e72e28;background: #e72e28; }
.login_box .plugin_area {text-align:right;}
.login_box .plugin_area a {background:url(../img/login/icon_arrow.png) no-repeat 0 50%;padding-left:10px;}
.login_box .plugin_area a span {position:relative;}
.login_box .plugin_area a span:after {position:absolute;bottom:-2px;left:0;height:1px;width:100%;background:#baafaf;display:block;content:"";}
.login_msg {clear:both;margin:84px 0 0 0;background:#5b6379;padding:30px 40px;color:rgba(255,255,255,0.66);font-size:15px;line-height:130%;}

.header_wrap {width:100%;min-width:1280px;height:51px;top:0;left:0;background:url(../img/common/header_bg.png) no-repeat right bottom;z-index:9;vertical-align:middle;border-bottom:4px solid #ee2d23;}
.header_wrap h1 {
	float: left;
	margin: 10px 0 0 10px;
}
.header_wrap #tnb_menu {
	float: left;
	margin: 17px 0 0 88px;
}
.header_wrap #tnb_menu li {
	position: relative;
	float: left;
	color: #d6d6d6;
}
.header_wrap #tnb_menu li a {
	color: #444444;
	font-size: 16px;
	font-weight: 600;
	padding: 0 12px 0 7px;
}
.header_wrap #tnb_menu li a:hover, .header_wrap #tnb_menu li a.active {
	color: #ee3124;
}
.header_wrap #tnb_menu li:after {
	display: block;
	content: "/";
	position: absolute;
	right: 0;
	top: 1px;
}
.header_wrap #tnb_menu li:last-child:after {
	display: none;
}
.header_wrap #tnb_menu li a i {
	margin-right: 5px;
}

.header_wrap #tnb_menu li a i.m1 {
	background:url(../img/common/menu01.png) 0 2px  no-repeat;
	padding: 0 20px 0 0;
}

.header_wrap #tnb_menu li a i.m2 {
	background:url(../img/common/menu02.png) 0 0  no-repeat;
	padding: 0 20px 0 0;
}

.header_wrap #tnb_menu li a i.m3 {
	background:url(../img/common/menu03.png) 0 0  no-repeat;
	padding: 0 20px 0 0;
}
.header_wrap #tnb_menu li a i.m4 {
	background:url(../img/common/menu04.png) 0 0  no-repeat;
	padding: 0 20px 0 0;
}
.header_wrap #tnb_menu li a i.m5 {
	background:url(../img/common/menu05.png) 0 0  no-repeat;
	padding: 0 20px 0 0;
}
.header_wrap #tnb_menu li a i.m6 {
    background:url(../img/common/menu06.png) 0 0  no-repeat;
    padding: 0 20px 0 0;
}

.header_wrap #tnb_menu li a.active i.m1{
	background:url(../img/common/menu01_on.png) 0 2px  no-repeat;
}

.header_wrap #tnb_menu li a.active i.m2{
	background:url(../img/common/menu02_on.png) 0 0  no-repeat;
}
.header_wrap #tnb_menu li a.active i.m3{
	background:url(../img/common/menu03_on.png) 0 0  no-repeat;
}

.header_wrap #tnb_menu li a.active i.m4{
	background:url(../img/common/menu04_on.png) 0 0  no-repeat;
}
.header_wrap #tnb_menu li a.active i.m5{
	background:url(../img/common/menu05_on.png) 0 0  no-repeat;
}
.header_wrap #tnb_menu li a.active i.m6{
    background:url(../img/common/menu06_on.png) 0 0  no-repeat;
}


.header_wrap .header_right {
	float: right;
	margin: 18px 46px 0 0;
}
.header_wrap .header_right p {
	display: inline-block;
	color: #666666;
	margin-right: 4px;
	font-weight: 400;
	font-size:13px/*font-size 추가*/
}
.header_wrap .header_right p strong {
	color: #000;
	font-weight: 600;
}
.header_wrap .header_right a {
	display: inline-block;
	margin-left: 10px;
	color: #444444;
}
.header_wrap .header_right a:hover {
	color: #222;
}
.header_wrap .header_right a img {
	margin-right: 8px;
}


.tableWrap {clear:both;}


/*searchform*/
.search-form-wrap {display: flex;flex-direction: row;flex-wrap: wrap;justify-content: space-between;align-items: stretch;align-content: center;margin:0;}
.search-form-wrap .search-item {flex: 8 0;background:#f1f2f4;border:1px solid #cfcfcf;}/*border-right:none;*/
.search-form-wrap .search-item-btn {width:79px;text-align:center;padding:0;color:#fff;}
.search-form-wrap .search-item-btn a {padding:8px 0;display:block;font-size:15px;background:#ee3124;border:1px solid #c92318;color:#ffffff}
.search-form-wrap .search-item-btn a:hover{background:#b9261c;border:1px solid #b9261c}
/*0510*/
.search-form-wrap .search-item-btn-d {width:79px;text-align:center;padding:0;color:#fff;}
.search-form-wrap .search-item-btn-d a {padding:8px 0;display:block;font-size:15px;background:#a2a2a2;border:1px solid #8c8c8c;color:#ececec;cursor: default;}

.search-form-wrap .search-item .search-item-inner {display: flex;flex-direction: row;flex-wrap: wrap;justify-content: space-between;justify-content: center;align-content: center;align-items: center;position:relative;height:100%;overflow:hidden;}
.search-form-wrap .search-item .search-item-inner .item {flex-grow: 1;padding:5px 5px;position:relative;}
/*.search-form-wrap .search-item .search-item-inner .item:after {display:block;content:"";position:absolute;right:0;top:-50%;height:200%;width:1px;background:#cfcfcf;}2021-01-18 삭제요청*/
.search-form-wrap .search-item .search-item-inner .item p.title,
.search-form-wrap .search-item .search-item-inner .item > div {display:inline-block;}
.search-form-wrap .search-item .search-item-inner .item p.title {background:url(../img/common/title.png) no-repeat 0 50%;padding:0 5px 0 10px;font-weight:600;}
.search-form-wrap .search-item .search-item-inner .item input[type=text] {width:70px;}
.search-form-wrap .search-item .search-item-inner .item select {min-width:120px;}

/*searchform 상세검색일경우*/
.search-form-wrap-d {display: flex;flex-direction: row;flex-wrap: wrap;justify-content: space-between;align-items: stretch;align-content: center;margin:0;}
.search-form-wrap-d .search-item {flex: 8 0;background:#f1f2f4;border:1px solid #cfcfcf}
.search-form-wrap-d .search-item-btn {width:79px;text-align:center;padding:0;color:#fff;}
.search-form-wrap-d .search-item-btn a {padding:8px 0;display:block;font-size:15px;background:#ee3124;border:1px solid #c92318;color:#ffffff}
/*상세검색버튼 2줄일 경우*/
.search-form-wrap-d .search-item-btn a.p2{padding:23px 0} 
.search-form-wrap-d .search-item-btn a.p2:hover{background:#b9261c;border:1px solid #b9261c}
/*상세검색버튼 3줄일 경우*/
.search-form-wrap-d .search-item-btn a.p3{padding:38px 0} 
.search-form-wrap-d .search-item-btn a.p3:hover{background:#b9261c;border:1px solid #b9261c}
/*상세검색버튼 4줄일 경우*/
.search-form-wrap-d .search-item-btn a.p4{padding:54px 0} 
.search-form-wrap-d .search-item-btn a.p4:hover{background:#b9261c;border:1px solid #b9261c}



.search-form-wrap-d .search-item .search-item-inner {display:table;flex-direction: row;flex-wrap: wrap;justify-content: space-between;justify-content: left;align-content: left;align-items: left;position:relative;overflow:hidden;}
.search-form-wrap-d .search-item .search-item-inner .item {padding:5px 5px;position:relative;display:table-cell}/*;flex-grow: 1;width:271px*/
/*.search-form-wrap-d .search-item .search-item-inner .item:after {display:block;content:"";position:absolute;right:0;top:-50%;height:200%;width:1px;background:#cfcfcf;}*/
.search-form-wrap-d .search-item .search-item-inner .item p.title,
.search-form-wrap-d .search-item .search-item-inner .item > div {display:inline-block;}
.search-form-wrap-d .search-item .search-item-inner .item p.title {background:url(../img/common/title.png) no-repeat 0 50%;padding:0 5px 0 10px;font-weight:600;}
.search-form-wrap-d .search-item .search-item-inner .item input[type=text] {width:100%;}
.search-form-wrap-d .search-item .search-item-inner .item select {min-width:120px;}




/*item 사이즈 & 배치 고정 */
.search-form-wrap .search-item .search-item-inner.fixed {justify-content: flex-start;}
.search-form-wrap .search-item .search-item-inner.fixed .item {flex-grow: 0;}
.search-form-wrap .search-item .search-item-inner.fixed .item:last-child:after  {display:none;}

/*treemenu*/
.tree_menu_area {float:left;width:20%;height:calc(100% - 38px);}
.tree_menu {display:block; padding:0;box-sizing:border-box;border:1px solid #d0d0d0;height:calc(100% - 42px);overflow-y:scroll;position:relative;}
.tree_wrap {position:relative;}
.tree_wrap:after {position:absolute;top:34px;left:19px;z-index:1;display:block;width:1px;height:calc(100% - 34px);content:"";background:#e2ccbd;}
.tree_menu .tree_main {background:#f3eae3;padding:10px;font-weight:600;color:#000000;position:relative;cursor:pointer}
.tree_menu .tree_main i {color:#d4352a;}
.tree_menu ul {width:100%; margin:0;padding:10px;box-sizing:border-box;}
.tree_menu ul li {margin:0; padding:0;box-sizing:border-box;position:relative;}
.tree_menu ul li a {display:block; color:#222222;position:relative;}
.tree_menu ul li p {position:relative; z-index:1; margin:0; }
.tree_menu ul li p.tree_dep1 a {background:url(../img/folder-closed.png) no-repeat  9px 6px;padding-left:40px;color:#333333;}
.tree_menu ul li p a {padding:6px 0px 6px 0;}
.tree_menu ul li p a:hover {color:#ee3124;text-decoration:none;}
.tree_menu ul li p.tree_dep1 a.active {background:url(../img/folder.png) no-repeat 9px 6px;color:#ee3124;}
.tree_menu ul li .notree a {background:url(../img/menu_paper.png) no-repeat 9px 5px !important;padding: 4px 0px 4px 40px !important;}
.tree_menu ul li ul li .notree a {background:url(../img/menu_paper.png) no-repeat 17px 5px !important;padding: 4px 0px 4px 45px !important;}
.tree_menu ul li ul {display:none; width:100%; padding:0px 0px 0 7px;position:relative;}
.tree_menu ul li ul:after {position:absolute;top:0px;left:23px;z-index:1;display:block;width:1px;height:100%;content:"";background:#e2ccbd;}
.tree_menu ul li ul li {margin:0; padding:0;}
.tree_menu ul li ul li a {padding:6px 0px 6px 50px;background:url(../img/menu_paper.png) no-repeat 17px 0px;}
.tree_menu ul li ul li a:hover {color:#ee3124;text-decoration:none;}
/* .tree_menu ul li ul li p.tree_dep1_1 a {background:url(../img/folder-closed_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px; } */
/* .tree_menu ul li ul li p.tree_dep1_1 a.active {background:url(../img/folder_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px;color:#ee3124;} */
.tree_menu ul li ul li p.tree_dep2 a {background:url(../img/folder-closed_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px; }
.tree_menu ul li ul li p.tree_dep2 a.active {background:url(../img/folder_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px;color:#ee3124;}
.tree_menu ul li ul li p.tree_dep3 a {background:url(../img/folder-closed_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px; }
.tree_menu ul li ul li p.tree_dep3 a.active {background:url(../img/folder_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px;color:#ee3124;}
.tree_menu ul li ul li p.tree_dep4 a {background:url(../img/folder-closed_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px; }
.tree_menu ul li ul li p.tree_dep4 a.active {background:url(../img/folder_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px;color:#ee3124;}
.tree_menu ul li ul li p.tree_dep5 a {background:url(../img/folder-closed_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px; }
.tree_menu ul li ul li p.tree_dep5 a.active {background:url(../img/folder_dep1.png) no-repeat 17px 5px;padding:4px 0px 4px 50px;color:#ee3124;}

.tree_menu ul li ul li ul {display:none; width:100%; padding:0px 0px 0 10px;position:relative;}
.tree_menu ul li ul li ul:after {position:absolute;top:0px;left:32px;z-index:1;display:block;width:1px;height:100%;content:"";background:#e2ccbd;}
.tree_menu ul li ul li ul li a {padding:6px 0px 6px 52px;background:url(../img/menu_paper.png) no-repeat 23px 6px;}
.tree_menu ul li ul li ul li a:hover {color:#ee3124;}
.tree_menu ul li ul li ul li a.active {color:#ee3124;}
/*.tree_menu ul li ul li:hover p a {color:#ee3124;}*/
.tree_menu ul li:hover ul li p  {font-weight:400;}
.tree_control_btn {margin-top:10px;}
.grid_control_btn {margin-top:10px;}

.tree_gridtable_area {float:right;width:78%;/*height:calc(100% - 38px);*/}
.tree_gridtable_area .gridtable {position:relative;height:100%;border:1px solid #d0d0d0;border-top:none;height:calc(100% - 42px);overflow-y:scroll;background:#f1f2f4;}
.tree_gridtable_area .gridtable table {border-left:0;}

.content_header {margin-bottom:50px;}
/*title*/
.main_title {position:relative;margin-bottom:12px;}
.sub_title{position:relative;margin-bottom:0;}
h3.title {background:url(../img/common/h3_title.png) no-repeat 0 0px;padding-left:31px;font-size:18px;font-weight:600;color:#000000;line-height:27px;}
h4.title {display:inline-block;background:url(../img/common/h4_title.png) no-repeat 0 6px;padding-left:10px;font-size:14px;font-weight:600;color:#000000;line-height:27px;margin:0 0 10px 0;}
.main_title .print_btn {position:absolute;right:0;top:0;border:1px solid #cfcfcf;border-radius:2px;background:#f1f2f4;color:#666666;font-size:12px;padding:0px 7px 0px 7px;line-height:25px;cursor:pointer;}
.main_title .print_btn i {border-right:1px solid #cfcfcf;margin-right:9px;padding-right:9px;}
#Main_logo_wr{width:150px; margin-left:10px; margin-top:-1px;}/* 추가 - 20250820 */


/* Button */
.btnWrap {
	z-index: 999;
	position: relative;
	margin: 10px 0;
}
.btnWrap:after {
	content: "";
	display: block;
	clear: both
}


/*작은사이즈 brown*/
.brown_btn_s {
	background: #786465;
	border-radius: 2px;
	border: 1px solid #654d4c;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	line-height: 19px;
	font-size: 12px;
}
.brown_btn_s:hover{
	background: #755153;
	border-radius: 2px;
	border: 1px solid #654d4c;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	line-height: 19px;
	font-size: 12px;

}
.brown_btn_s:disabled{
	background: #787878;
	color: #e2e2e2;
}

.grid_inbtn_s {
	background: #fff;
	border-radius: 2px;
	border: 1px solid #666;
	color: #202020;
	padding: 0px 7px;
	display: inline-block;
	line-height: 19px;
	font-size: 12px;
}
.grid_inbtn_s:hover{
	background: #ee3124;
	border-radius: 2px;
	border: 1px solid #b9261c;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	line-height:19px;
	font-size: 12px;

}
.grid_inbtn_s:disabled{
	background: #787878;
	color: #e2e2e2;
}

/*조회*/
.btn-search {
	background: #4b5378;
	background: -moz-linear-gradient(top, #ee3124 0%, #e52a1d 100%);
	background: -webkit-linear-gradient(top, #ee3124 0%, #e52a1d  100%);
	background: linear-gradient(to bottom, #ee3124 0%, #e52a1d 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ee3124', endColorstr='#e52a1d', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #ca281d;
	line-height: 25px;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
}
.btn-search span{background: url(../img/btn-search.png) 0 0  no-repeat;padding: 0 0 0 23px;}
.btn-search:hover{
	background: #4b5378;
	background: -moz-linear-gradient(top, #ee3124 0%, rgb(247, 247, 250) 100%);
	background: -webkit-linear-gradient(top, #ee3124 0%, #e52a1d 100%);
	background: linear-gradient(to bottom, #ee3124 0%,#ee3124 100%);
filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='red', endColorstr='#e52a1d', GradientType=0 );
	border-radius: 2px;
	border: 1px solid #ca281d;
	line-height: 25px;
	color: #fff;
	padding: 0px 7px;
	display: inline-block;
	font-size: 12px;
}

.btn-search:disabled{
	background: #787878;
	background: -moz-linear-gradient(top, #787878 0%, #6a6a6a 100%);
	background: -webkit-linear-gradient(top, #787878 0%, #6a6a6a 100%);
