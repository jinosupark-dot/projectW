.tabs{display: block;position:relative;padding:0;margin:0;border-bottom:1px solid #ee3124}
.tabs::after{content: '';display: block;clear: both;}
.tabs li{display: block;background:#928283;color:#fff;text-align: center;float:left;margin-right:3px;padding:7px 14px 6px 14px;border-top:1px solid #8d7d7e;border-right:1px solid #8d7d7e;border-left:1px solid #8d7d7e}
.tabs li a{background:#928283;line-height: 15px; color: #fff;text-align: center;}
.tabs li.active{background:#ee3124;border-top:1px solid #ee3124;border-right:1px solid #ee3124;border-left:1px solid #ee3124}
.tabs li.active a{background:#ee3124;line-height: 15px; color: #fff;text-align: center;}
.tab_content{padding:10px 0 0 0 }

.tableB {display: table;width:100%;border-collapse: collapse;box-sizing:border-box;}

.tableB tbody td {color:#444444;font-size:13px;box-sizing:border-box;vertical-align: middle;padding:4px 0 4px 0}
.tableB tbody td p.title {background:url(../img/common/title.png) no-repeat 0 50%;padding:0 5px 0 10px;font-weight:600;}
/*그리드 안에 들어가는 버튼*/
.btn_grid_delete{background: url(../img/icon_grid_del.png) 50% 50% no-repeat;padding: 0 16px;display: inline-block;width: 21px;height:25px;}
.btn_grid_update{background: url(../img/icon_grid_update.png) 50% 50% no-repeat;padding: 0 16px;color:#786565;font-weight: 500;display: inline-block;width: 21px;height:25px}
.btn_grid_insert{background: url(../img/icon_grid_insert.png) 50% 50% no-repeat;padding: 0 16px;color:#779dc2;font-weight: 500;display: inline-block;width: 21px;height:25px}
.btn_grid_excel{background: url(../img/icon_grid_excel.png) 50% 50% no-repeat;padding: 0 16px;color:#7fb480;font-weight: 500;display: inline-block;width: 21px;height:25px}


/*0205 그리드  소계,합계 스타일*/
.jsgrid-table .sub-total{color:#b9261c;font-weight:bold;font-style:italic; border:10}
.total{color:#9a160d !important;font-weight:bold}

/*0209 기표용 정보 생성*/
.info-box{background: #f9f9f9;border-top:1px solid #ee2d23;padding:20px;}
/*0427 상품설명*/
.info-box2{background: #fff;border:1px solid #cfcfcf;padding:20px;background:#fefefe}
.info-box2 .tt{font-size:15px;font-weight:600; color:#ee2d23;line-height:16px;padding:2px 0 10px 0}
.info-box2 .txt strong{font-weight:500}
.info-box2 .txt{font-size:13px;color:#333;line-height:15px;padding: 5px 0}

/*0409*/
.t_btn_search{border:1px solid #ee2d23 !important;background:#ee2d23;color:#fff;font-sieze:12px;text-align:center;padding:2px 10px 3px 10px;line-height:15px}
.tooltip{position:relative;top:5px;margin-left:10px;cursor:pointer}


